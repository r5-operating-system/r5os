+static void
+diag_dump(const char* name, const uint8* bits, uint32 width, uint32 height,
+	uint32 pitch)
+{
+	FILE* file = fopen(name, "wb");
+	if (file == NULL)
+		return;
+	fprintf(file, "P6\n%u %u\n255\n", (unsigned)width, (unsigned)height);
+	uint8* row = (uint8*)malloc(width * 3);
+	for (uint32 y = 0; row != NULL && y < height; y++) {
+		const uint8* in = bits + (size_t)y * pitch;
+		for (uint32 x = 0; x < width; x++) {
+			row[x * 3] = in[x * 4 + 2];
+			row[x * 3 + 1] = in[x * 4 + 1];
+			row[x * 3 + 2] = in[x * 4];
+		}
+		fwrite(row, 1, width * 3, file);
+	}
+	free(row);
+	fclose(file);
+}
