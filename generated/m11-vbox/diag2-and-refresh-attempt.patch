+# A mode change on Lavapipe: another mode and back. VirtualBox showed the
+# old mode's pixels after one; the compositor now repeats the whole picture
+# after a mode change, and gpu_debug compares the screen with the frame.
+m11_mode() {
+	: > "$keep/mode.txt"
+	: > "$keep/mode-syslog.txt"
+	if [ "$live" -eq 1 ]; then
+		from=$(syslog_count)
+		was=$(screenmode -s 2>/dev/null | head -n 1)
+		set -- $was
+		if [ "${1:-0}" = 1024 ]; then
+			other="800 600 32"
+		else
+			other="1024 768 32"
+		fi
+		echo "was: $was; other: $other" >> "$keep/mode.txt"
+		screenmode -q $other >> "$keep/mode.txt" 2>&1
+		echo "exit $?" >> "$keep/mode.txt"
+		sleep 6
+		if [ -n "$was" ]; then
+			screenmode -q $was >> "$keep/mode.txt" 2>&1
+			echo "exit $?" >> "$keep/mode.txt"
+		fi
+		sleep 6
+		syslog_since "$from" > "$keep/mode-syslog.txt"
+	fi
+	atleast 2 'app_server: frame follows the screen [0-9]+x[0-9]+' \
+		"$keep/mode-syslog.txt" "frame follows the screen x2 (mode change)"
+	atleast 2 'app_server: mode refresh compare ok' "$keep/mode-syslog.txt" \
+		"mode refresh compare ok x2"
+	none 'mode refresh compare MISMATCH' "$slog" "never mode refresh compare MISMATCH"
+}
+
