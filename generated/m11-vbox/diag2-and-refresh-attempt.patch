+/*!	The compose thread, after a mode change: the whole last frame goes to
+	the screen again, so a display that missed the first full copy after
+	SetMode gets one more (VirtualBox vboxvideo showed the old mode's
+	pixels with the new line length). Only the CPU copy: on the scanout
+	way the GPU writes the screen itself. With gpu_debug, the last repeat
+	compares the screen with the frame.
+*/
+void
+Compositor::_ModeRefresh()
+{
+	BAutolock slot(fComposeSlot);
+	int32 step = fModeRefreshStep;
+	if (++fModeRefreshStep >= kModeRefreshCount) {
+		fModeChangedAt = 0;
+		fModeRefreshStep = 0;
+	}
+	RenderingBuffer* back = fScreen->BackBuffer();
+	if (fPaused || fVulkan->scanActive || back == NULL
+		|| back->Width() != fFrameWidth || back->Height() != fFrameHeight)
+		return;
+	BRegion screen(BRect(0, 0, (float)fFrameWidth - 1,
+		(float)fFrameHeight - 1));
+	_Present(screen);
+	if (!fDebug || step != kModeRefreshCount - 1)
+		return;
+
+	// gpu_debug: the screen against the frame, colour channels only,
+	// without the software cursor, which is drawn on the screen only
+	if (!fScreen->LockExclusiveAccess())
+		return;
+	RenderingBuffer* front = fScreen->FrontBuffer();
+	clipping_rect cursor = { -1, -1, -2, -2 };
+	static_cast<AccelerantHWInterface*>(fScreen)->SoftwareCursorFrame(&cursor);
+	int32 badX = -1;
+	int32 badY = -1;
+	bool checked = front != NULL && front->Width() == fFrameWidth
+		&& front->Height() == fFrameHeight
+		&& (front->ColorSpace() == B_RGB32 || front->ColorSpace() == B_RGBA32);
+	for (uint32 y = 0; checked && badY < 0 && y < fFrameHeight; y++) {
+		const uint32* screenRow = (const uint32*)((const uint8*)front->Bits()
+			+ (size_t)y * front->BytesPerRow());
+		const uint32* frameRow = fVulkan->frameBits + (size_t)y * fFrameWidth;
+		for (uint32 x = 0; x < fFrameWidth; x++) {
+			if ((int32)x >= cursor.left && (int32)x <= cursor.right
+				&& (int32)y >= cursor.top && (int32)y <= cursor.bottom)
+				continue;
+			if (((screenRow[x] ^ frameRow[x]) & 0x00ffffff) != 0) {
+				badX = x;
+				badY = y;
+				break;
+			}
+		}
+	}
+	fScreen->UnlockExclusiveAccess();
+	if (!checked) {
+		log_line("mode refresh compare skipped");
+	} else if (badY >= 0) {
+		log_line("mode refresh compare MISMATCH %" B_PRIu32 "x%" B_PRIu32
+			" at %" B_PRId32 ",%" B_PRId32, fFrameWidth, fFrameHeight, badX,
+			badY);
+	} else {
+		log_line("mode refresh compare ok %" B_PRIu32 "x%" B_PRIu32,
+			fFrameWidth, fFrameHeight);
+	}
+}
