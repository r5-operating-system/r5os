#!/bin/sh
# SPDX-FileCopyrightText: 2026 R5OS Contributors
# SPDX-License-Identifier: MIT
#
# M10 stick: PASS or FAIL per line for the current boot. The boot is read
# from the radeon_hd settings file: none or only gpu_selftest true = 1, gpu_opengl true = 1b,
# gpu_hang_test 1 = 2, gpu_hang_test 2 = 3, gpu false = 4,
# gpu_app_server true = 5 and with gpu_app_server_fail true = 6 (both
# optional). boot-next notes
# the same number in ~/m10/next; a mismatch is a FAIL. Files go to
# ~/m10/boot<k>/. A directory that already has a check.txt is never
# reused: the next one is boot<k>-2, boot<k>-3, ...
#
# M11 stick: a settings file with gpu_compositor true is an M11 boot:
# gpu_hang_test 1 = 4, gpu_compositor_lavapipe true = 3,
# gpu_compositor_fail true = 2, otherwise 1 (generated/gpu-m11/BRIEF.md,
# "Stick (step 6)"). The note and the files are in ~/m11 instead of ~/m10.
# "check wait" only waits for the self-test and says when the scenario
# can start; it writes nothing. In boot 1 check runs r5-share-check and
# VulkanTeapot twice (zero-copy, then the copy path with
# gpu_compositor_zero_copy false for that run only), about three minutes.
#
# For the host tests: R5_HOME, R5_SYSLOG, R5_SYSTEM_SETTINGS and
# R5_NODE_DIR, R5_USER_SETTINGS, R5_CACHE and R5_BIN move the paths,
# CHECK_WAIT=0 does not wait, CHECK_LIVE=0 runs no program.

echo "check: start"
# finddir gives the Haiku directories; the fallback is for the host tests.
fd() {
	finddir "$1" 2>/dev/null || echo "$2"
}

home=${R5_HOME:-$(fd B_USER_DIRECTORY /boot/home)}
syslog=${R5_SYSLOG:-$(fd B_SYSTEM_LOG_DIRECTORY /boot/system/var/log)/syslog}
sysset=${R5_SYSTEM_SETTINGS:-$(fd B_SYSTEM_SETTINGS_DIRECTORY /boot/system/settings)/kernel/drivers/radeon_hd}
nodes=${R5_NODE_DIR:-/dev/gpu/radeon_hd}
wait_s=${CHECK_WAIT:-900}
live=${CHECK_LIVE:-1}
bin=${R5_BIN:-/bin}
m10=$home/m10
cache=${R5_CACHE:-$(fd B_USER_CACHE_DIRECTORY "$home/config/cache")}
selftest=$cache/r5-gpu-selftest.txt
settings=${R5_USER_SETTINGS:-$(fd B_USER_SETTINGS_DIRECTORY "$home/config/settings")}/kernel/drivers/radeon_hd
bad=0

mkdir -p "$m10"
if [ ! -f "$settings" ]; then
	settings=$sysset
fi

# Which boot is this? M11 first: its boot 4 also has gpu_hang_test 1.
stick=m10
if [ -f "$settings" ] && grep -q '^gpu_compositor true' "$settings"; then
	stick=m11
	if grep -Eq '^gpu_hang_test[[:space:]]+1' "$settings"; then
		boot=4
	elif grep -q '^gpu_compositor_lavapipe true' "$settings"; then
		boot=3
	elif grep -q '^gpu_compositor_fail true' "$settings"; then
		boot=2
	else
		boot=1
	fi
elif [ ! -f "$settings" ]; then
	boot=1
elif grep -q '^gpu_app_server_fail true' "$settings"; then
	boot=6
elif grep -q '^gpu_app_server true' "$settings"; then
	boot=5
elif grep -q '^gpu false' "$settings"; then
	boot=4
elif grep -Eq '^gpu_hang_test[[:space:]]+2' "$settings"; then
	boot=3
elif grep -Eq '^gpu_hang_test[[:space:]]+1' "$settings"; then
	boot=2
elif grep -q '^gpu_opengl true' "$settings"; then
	boot=1b
elif ! grep -Ev '^(gpu_selftest true)?[[:space:]]*$' "$settings" | grep -q .; then
	# Only gpu_selftest true: boot 1, every GPU switch at its default.
	boot=1
else
	echo "FAIL settings match no boot: $settings"
	echo FAIL
	exit 1
fi

# M11: its own note and files, so the M10 boots are never mixed in.
if [ "$stick" = m11 ]; then
	m10=$home/m11
	mkdir -p "$m10"
fi

# check wait: the self-test only, nothing written.
if [ "$1" = wait ]; then
	i=0
	while [ "$i" -lt "$wait_s" ] && ! grep -q '^selftest done' "$selftest" 2>/dev/null; do
		if [ $((i % 30)) -eq 0 ]; then
			echo "check: waiting for the self-test, $i of $wait_s s"
		fi
		sleep 5
		i=$((i + 5))
	done
	if grep -q '^selftest done' "$selftest" 2>/dev/null; then
		# M11: the last syslog line now; the scenario's lines come after
		# it, so the self-test's own windows do not count for it.
		if [ "$stick" = m11 ] && [ -f "$syslog" ]; then
			tail -n 1 "$syslog" > "$m10/scenario-from-boot$boot"
		fi
		echo "check: the self-test is done; start the scenario now (boot $boot)"
		exit 0
	fi
	echo "FAIL the self-test did not finish in $wait_s s"
	exit 1
fi

# Never overwrite an earlier boot's files.
keep=$m10/boot$boot
n=2
while [ -f "$keep/check.txt" ]; do
	keep=$m10/boot$boot-$n
	n=$((n + 1))
done
mkdir -p "$keep"
report=$keep/check.txt
: > "$report"

emit() {
	printf '%s\n' "$1" | tee -a "$report"
}
say() {
	if [ "$1" -eq 0 ]; then
		emit "PASS $2"
	else
		emit "FAIL $2"
		bad=1
	fi
}
# have <pattern> <file> <text>: the pattern is in the file.
have() {
	if [ -s "$2" ] && grep -Eq -- "$1" "$2"; then
		say 0 "$3"
	else
		say 1 "$3"
	fi
}
# none <pattern> <file> <text>: the file has text and no such line.
none() {
	if [ -s "$2" ] && ! grep -Eq -- "$1" "$2"; then
		say 0 "$3"
	else
		say 1 "$3"
	fi
}
# atleast <n> <pattern> <file> <text>
atleast() {
	c=0
	if [ -s "$3" ]; then
		c=$(grep -Ec -- "$2" "$3" || true)
	fi
	if [ "$c" -ge "$1" ]; then
		say 0 "$4"
	else
		say 1 "$4 (found $c, want $1)"
	fi
}
# exactly <n> <pattern> <file> <text>
exactly() {
	c=0
	if [ -s "$3" ]; then
		c=$(grep -Ec -- "$2" "$3" || true)
	fi
	if [ "$c" -eq "$1" ]; then
		say 0 "$4"
	else
		say 1 "$4 (found $c, want $1)"
	fi
}
manual() {
	emit "MANUAL $1"
}

# Wait for the self-test. It writes "selftest done" last.
if [ "$wait_s" -gt 0 ]; then
	i=0
	while [ "$i" -lt "$wait_s" ] && ! grep -q '^selftest done' "$selftest" 2>/dev/null; do
		if [ $((i % 30)) -eq 0 ]; then
			stage=$(grep '^stage ' "$selftest" 2>/dev/null | tail -n 1 | cut -d' ' -f2-3)
			echo "check: waiting for the self-test, $i of $wait_s s (${stage:-not started})"
		fi
		sleep 5
		i=$((i + 5))
	done
fi

# The syslog since the last boot marker. syslog_daemon keeps one older file.
extract_syslog() {
	: > "$keep/syslog.all"
	for part in "$syslog.1" "$syslog.old" "$syslog"; do
		if [ -f "$part" ]; then
			cat "$part" >> "$keep/syslog.all"
		fi
	done
	awk '
		/Welcome to the Haiku boot loader!/ { buf = ""; seen = 1 }
		{ all = all $0 "\n" }
		seen { buf = buf $0 "\n" }
		END { if (seen) printf "%s", buf; else printf "%s", all }
	' "$keep/syslog.all" > "$keep/syslog.txt"
	rm -f "$keep/syslog.all"
}
extract_syslog
slog=$keep/syslog.txt

# The hang test writes its lines late. Wait for the last one.
case $stick$boot in
m102) until_pat='gpu selftest after reset (ok|failed)' ;;
m103) until_pat='gpu off until reboot' ;;
m114) until_pat='gpu compositor (restarted after reset|off)|gpu off until reboot' ;;
*) until_pat= ;;
esac
if [ "$wait_s" -gt 0 ] && [ -n "$until_pat" ]; then
	i=0
	while [ "$i" -lt 180 ] && ! grep -Eq "$until_pat" "$slog"; do
		sleep 5
		i=$((i + 5))
		extract_syslog
	done
fi

# Copy the boot's files.
if [ -f "$settings" ]; then
	cp "$settings" "$keep/radeon_hd"
else
	echo "(no settings file)" > "$keep/radeon_hd"
fi
for f in "$selftest" "$cache/r5-gpu-selftest.old.txt" "$home/r5-session.log" \
		"$home"/wsi.txt "$home"/win-*.txt; do
	if [ -f "$f" ]; then
		cp "$f" "$keep/"
	fi
done

# Live runs: the GPU state of right now.
runlive() {
	name=$1
	shift
	: > "$keep/$name.txt"
	if [ "$live" -eq 1 ]; then
		start=$(date +%s)
		R5_GL_TRACE=1 timeout 180 "$@" > "$keep/$name.txt" 2>&1
		echo "exit $? after $(( $(date +%s) - start )) s" >> "$keep/$name.txt"
		sync
		sleep 3
	fi
}

emit "boot $boot ($stick)"
if [ -f "$settings" ]; then
	emit "settings: $(tr '\n' ' ' < "$settings")"
else
	emit "settings: none (the default)"
fi

# The note from boot-next. No note means boot 1.
want=1
if [ -f "$m10/next" ]; then
	want=$(head -n 1 "$m10/next" | tr -d ' \r')
fi
if [ "$want" = "$boot" ]; then
	say 0 "boot number matches $stick/next"
else
	say 1 "boot number $boot, but $stick/next says $want"
fi

have 'Welcome to the Haiku boot loader!' "$slog" "boot marker"
have '^selftest done' "$selftest" "self-test finished"

contract() {
	atleast "$1" 'GFX9 scratch 0xdeadbeef' "$slog" "GFX9 scratch 0xdeadbeef x$1"
	atleast "$1" 'fence landed' "$slog" "fence landed x$1"
	atleast "$1" 'k2 ok gart' "$slog" "k2 ok gart x$1"
}

# RADV must be GPU0 in vulkaninfo --summary.
radv_first() {
	name=$(awk '/^GPU0:/ { on = 1; next } /^GPU[1-9]:/ { on = 0 }
		on && /deviceName/ { sub(/^[^=]*= */, ""); print; exit }' "$selftest" 2>/dev/null)
	if [ -n "$name" ] && echo "$name" | grep -q RADV; then
		say 0 "RADV is device 0 ($name)"
	else
		say 1 "RADV is device 0 (GPU0 is: ${name:-none})"
	fi
}

# The lines of one self-test stage, up to the next stage.
section() {
	awk -v t="$1" '
		$0 ~ "^stage " t " t [0-9]" { on = 1; next }
		/^stage / { on = 0 }
		on' "$selftest" 2>/dev/null
}

teapot_ok() {
	section "VulkanTeapot" > "$keep/stage-teapot.txt"
	have '^pixels ok max 2' "$keep/stage-teapot.txt" "VulkanTeapot pixels ok max 2"
	none 'pixels MISMATCH' "$selftest" "no pixels MISMATCH in the self-test"
}
gl_stage() {
	section "gl" > "$keep/stage-gl.txt"
	have 'compared zink.*RADV.* and llvmpipe' "$keep/stage-gl.txt" \
		"stage gl: compared zink RADV and llvmpipe"
	have '^pixels ok max 2' "$keep/stage-gl.txt" "stage gl: pixels ok max 2"
	atleast 2 '^gl ms per frame' "$keep/stage-gl.txt" "stage gl: gl ms per frame twice"
}
window_ok() {
	w=$home/win-glteapot.txt
	have 'window driver zink.*RADV' "$w" "win-glteapot: window driver zink RADV"
	for a in resize workspace minimise restore close; do
		have "^window $a ok" "$w" "win-glteapot: window $a ok"
	done
	none '^window .*(FAIL|fail)' "$w" "win-glteapot: no failed action"
	have '^device lost no' "$w" "win-glteapot: device lost no"
}

# --- M11 (generated/gpu-m11/BRIEF.md, "Stick (step 6)") ---

# The syslog from line n + 1 on, for a live run of check itself.
syslog_count() {
	if [ -f "$syslog" ]; then
		wc -l < "$syslog" | tr -d ' '
	else
		echo 0
	fi
}
syslog_since() {
	tail -n +"$(($1 + 1))" "$syslog" 2>/dev/null
}
# wait_line <pattern> <from line> <seconds>
wait_line() {
	j=0
	while [ "$j" -lt "$3" ]; do
		if syslog_since "$2" | grep -Eq -- "$1"; then
			return 0
		fi
		sleep 1
		j=$((j + 1))
	done
	return 1
}
# The numbers of a line, as one list: values <sed expression> <file>
values() {
	sed -n "$1" "$2" 2>/dev/null | tr '\n' ' '
}

# VulkanTeapot for 30 s, with the buffer count before, during and after.
teapot_run() {
	name=$1
	: > "$keep/$name.txt"
	if [ "$live" -ne 1 ]; then
		return
	fi
	from=$(syslog_count)
	"$bin"/r5-share-check count > "$keep/$name-count.txt" 2>&1
	timeout 90 "$bin"/VulkanTeapot --window --seconds 30 \
		> "$keep/$name.txt" 2>&1 &
	tp=$!
	sleep 10
	"$bin"/r5-share-check count >> "$keep/$name-count.txt" 2>&1
	wait "$tp"
	echo "exit $?" >> "$keep/$name.txt"
	sleep 2
	"$bin"/r5-share-check count >> "$keep/$name-count.txt" 2>&1
	syslog_since "$from" > "$keep/$name-syslog.txt"
}
teapot_report() {
	name=$1
	what=$2
	have '^window fps [0-9]' "$keep/$name.txt" "VulkanTeapot fps line ($what)"
	fps=$(values 's/^window fps \([0-9.]*\) .*/\1/p' "$keep/$name.txt")
	cpu=$(values 's/.*app_server: team cpu \([0-9]*\) ms per 10 s.*/\1/p' \
		"$keep/$name-syslog.txt")
	med=$(values 's/.*compose median \([0-9]*\) us cpu \([0-9]*\) ms.*/\1 us \2 ms/p' \
		"$keep/$name-syslog.txt")
	bos=$(values 's/^r5-share-check: buffers \([0-9-]*\)/\1/p' "$keep/$name-count.txt")
	emit "INFO $what: fps ${fps:-none}; app_server team cpu ms per 10 s: ${cpu:-none}"
	emit "INFO $what: compose median, cpu per 10 s: ${med:-none}"
	emit "INFO $what: bo_count before, during, after VulkanTeapot: ${bos:-none}"
	printf '%s fps %s team_cpu %s compose %s bo %s\n' "$what" "${fps:-none}" \
		"${cpu:-none}" "${med:-none}" "${bos:-none}" >> "$keep/measure.txt"
}

m11_common() {
	have 'decorator: r5 loaded' "$slog" "decorator: r5 loaded"
	if [ "$boot" != 4 ]; then
		none 'gpu lost' "$slog" "no gpu lost"
	# Boot 4: every hang dumps "radeon_hd: gpu lost watchdog ..." (the
	# kernel's gpu_lost, also before a good reset). Any other gpu lost
	# line is a fault.
	elif [ -s "$slog" ] && ! grep -E 'gpu lost' "$slog" \
			| grep -vq 'gpu lost watchdog'; then
		say 0 "no gpu lost other than the hang's watchdog dump"
	else
		say 1 "no gpu lost other than the hang's watchdog dump ($(grep -E 'gpu lost' \
			"$slog" | grep -v 'gpu lost watchdog' | head -n 1))"
	fi
}

m11_compose() {
	atleast 1 'app_server: compose compare ok' "$slog" "compose compare ok"
	none 'compose compare MISMATCH' "$slog" "never compose compare MISMATCH"
	atleast 3 'app_server: compose median [0-9]+ us cpu [0-9]+ ms per 10 s' "$slog" \
		"compose median x3"
	have 'compose effects shadow on frosted on' "$slog" "a median with effects"
	have 'compose effects shadow off frosted off' "$slog" "a median without effects"
	have 'app_server: window memory [0-9]+ MB' "$slog" "window memory <n> MB"
	none 'app_server: gpu compositor off' "$slog" "no gpu compositor off"
}

m11_window_memory() {
	# Decision 5: the window buffer is host-cached (Vulkan bit 0x8).
	flags=$(sed -n 's/.*app_server: window memory type [0-9]* flags \(0x[0-9a-fA-F]*\).*/\1/p' \
		"$slog" | head -n 1)
	if [ -n "$flags" ] && [ $((flags & 8)) -ne 0 ]; then
		say 0 "window memory type flags $flags with the cached bit"
	else
		say 1 "window memory type with the cached bit (flags: ${flags:-none})"
	fi
	have 'radeon_hd: bo domain .* snooped 1' "$slog" "kernel bo line with snooped 1"
	line=$(grep -E 'app_server: window buffer write fill' "$slog" | head -n 1)
	set -- $(echo "$line" | sed -n \
		's/.*fill \([0-9]*\) us blend \([0-9]*\) us, malloc fill \([0-9]*\) us blend \([0-9]*\) us.*/\1 \2 \3 \4/p')
	if [ $# -eq 4 ]; then
		emit "INFO Painter write test: buffer fill $1 us blend $2 us, malloc fill $3 us blend $4 us"
		echo "painter buffer_fill $1 buffer_blend $2 malloc_fill $3 malloc_blend $4" \
			>> "$keep/measure.txt"
		if [ "$2" -le $(($4 * 2 + 100)) ] && [ "$1" -le $(($3 * 2 + 100)) ]; then
			say 0 "Painter write test: window buffer at most 2x malloc"
		else
			say 1 "Painter write test: window buffer at most 2x malloc"
		fi
	else
		say 1 "Painter write test line"
	fi
}

m11_share() {
	runlive share "$bin"/r5-share-check
	for c in "argv\[0\] app_server as a user refused" \
			"import by a program that is not app_server refused" \
			"second import of the same number refused"; do
		have "^r5-share-check: $c: pass" "$keep/share.txt" \
			"r5-share-check: $(echo "$c" | sed 's/\\//g'): pass"
	done
	none ': fail' "$keep/share.txt" "r5-share-check: no fail"
	# The exporter stopped before an import: the count comes back.
	: > "$keep/share-hold.txt"
	if [ "$live" -eq 1 ]; then
		"$bin"/r5-share-check count >> "$keep/share-hold.txt" 2>&1
		"$bin"/r5-share-check hold >> "$keep/share-hold.txt" 2>&1 &
		hp=$!
		sleep 3
		kill "$hp" 2>/dev/null
		wait "$hp" 2>/dev/null
		sleep 2
		"$bin"/r5-share-check count >> "$keep/share-hold.txt" 2>&1
	fi
	have 'hold: exported' "$keep/share-hold.txt" "r5-share-check hold: exported"
	n=$(values 's/^r5-share-check: buffers \([0-9-]*\)/\1/p' "$keep/share-hold.txt")
	set -- $n
	# -1 means no render node: not a count, so not a pass.
	if [ $# -eq 2 ] && [ "$1" = "$2" ] && [ "$1" -ge 0 ] 2>/dev/null; then
		say 0 "exporter stopped: buffers $1 before and after"
	else
		say 1 "exporter stopped: the same buffer count before and after (got: ${n:-none})"
	fi
}

# Zero-copy, then the copy path in the same boot. app_server reads the
# switch at every 10 s report, so check waits for its line each time.
m11_fps() {
	teapot_run teapot-zero-copy
	have 'app_server: window [0-9]+ zero-copy on' "$keep/teapot-zero-copy-syslog.txt" \
		"check's VulkanTeapot: zero-copy on"
	teapot_report teapot-zero-copy zero-copy
	if [ "$live" -ne 1 ]; then
		say 1 "copy path run (CHECK_LIVE=0)"
		return
	fi
	if [ "$settings" = "$sysset" ]; then
		say 1 "copy path run: the settings file is the system one"
		return
	fi
	cp "$settings" "$keep/radeon_hd.orig"
	from=$(syslog_count)
	rm -f "$settings"
	{ cat "$keep/radeon_hd.orig"; echo "gpu_compositor_zero_copy false"; } > "$settings"
	if wait_line 'app_server: zero-copy setting off' "$from" 30; then
		say 0 "zero-copy setting off"
		teapot_run teapot-copy
		have 'app_server: window [0-9]+ zero-copy off: setting' \
			"$keep/teapot-copy-syslog.txt" "check's VulkanTeapot: zero-copy off: setting"
		teapot_report teapot-copy copy-path
	else
		say 1 "zero-copy setting off (no line in 30 s)"
	fi
	from=$(syslog_count)
	rm -f "$settings"
	cp "$keep/radeon_hd.orig" "$settings"
	if wait_line 'app_server: zero-copy setting on' "$from" 30; then
		say 0 "zero-copy setting on again"
	else
		say 1 "zero-copy setting on again (no line in 30 s)"
	fi
}

m11_boot() {
	m11_common
	case $boot in
	1)
		have 'radeon_hd: gpu available' "$slog" "radeon_hd: gpu available"
		have 'app_server: gpu compositor on radv' "$slog" "gpu compositor on radv"
		m11_compose
		# The scenario's lines: after the last syslog line at check wait,
		# so the self-test's own Vulkan, GL and DirectWindow windows do
		# not count. Without check wait the file is empty: FAIL.
		scen=$keep/scenario-syslog.txt
		: > "$scen"
		mark=$m10/scenario-from-boot$boot
		if [ -s "$mark" ]; then
			M=$(cat "$mark") awk '
				$0 == ENVIRON["M"] { buf = ""; seen = 1; next }
				seen { buf = buf $0 "\n" }
				END { printf "%s", buf }
			' "$slog" > "$scen"
		fi
		have '.' "$scen" "scenario lines after check wait"
		# The scenario's VulkanTeapot and vkcube, before check's own runs.
		atleast 2 'app_server: window [0-9]+ zero-copy on' "$scen" \
			"zero-copy on for VulkanTeapot and vkcube"
		if grep -E 'app_server: window [0-9]+ zero-copy off' "$slog" \
				| grep -vq 'off: setting'; then
			say 1 "no zero-copy off on RADV ($(grep -E 'zero-copy off' "$slog" | head -n 1))"
		else
			say 0 "no zero-copy off on RADV"
		fi
		m11_window_memory
		for e in shadow frosted animations; do
			have "app_server: $e off" "$scen" "$e off"
			have "app_server: $e on" "$scen" "$e on"
		done
		for a in open close workspace; do
			have "app_server: animation $a [0-9]+ ms frames [0-9]+" "$scen" \
				"animation $a"
		done
		have 'app_server: compositor paused: direct window' "$scen" \
			"compositor paused: direct window (Chart)"
		have 'app_server: compositor resumed' "$scen" "compositor resumed"
		m11_share
		m11_fps
		extract_syslog
		none 'app_server: gpu compositor off' "$slog" "no gpu compositor off after check's runs"
		manual "Chart (BDirectWindow) drew correctly: ____"
		manual "shadow and frosted glass visible, then gone, then back: ____"
		;;
	2)
		have 'app_server: gpu compositor on radv' "$slog" "gpu compositor on radv"
		exactly 1 'app_server: gpu compositor off' "$slog" "one gpu compositor off"
		have 'app_server: gpu compositor off: forced failure' "$slog" \
			"gpu compositor off: forced failure"
		manual "desktop kept working in the CPU mode, R5 frame (no shadow): ____"
		;;
	3)
		have 'app_server: gpu compositor on lavapipe: forced' "$slog" \
			"gpu compositor on lavapipe: forced"
		m11_compose
		have 'app_server: window [0-9]+ zero-copy off: lavapipe' "$slog" \
			"zero-copy off: lavapipe"
		teapot_run teapot-lavapipe
		teapot_report teapot-lavapipe lavapipe
		;;
	4)
		have 'app_server: gpu compositor on radv' "$slog" "gpu compositor on radv"
		exactly 1 'radeon_hd: gpu hang ring' "$slog" "one gpu hang"
		have 'radeon_hd: gpu reset mode2 ok' "$slog" "gpu reset mode2 ok"
		have 'radeon_hd: gpu selftest after reset ok' "$slog" "gpu selftest after reset ok"
		have 'app_server: gpu compositor restarted after reset' "$slog" \
			"gpu compositor restarted after reset"
		none 'app_server: gpu compositor off' "$slog" "no gpu compositor off"
		none 'gpu off until reboot' "$slog" "no gpu off until reboot"
		manual "the pointer moved the whole time: ____"
		;;
	esac
}

if [ "$stick" = m11 ]; then
	m11_boot
else
case $boot in
1|1b)
	if [ "$boot" = 1 ]; then
		have 'radeon_hd: gpu available' "$slog" "radeon_hd: gpu available"
	fi
	contract 1
	radv_first
	teapot_ok
	have 'egl: opengl zink:.*RADV' "$slog" "egl: opengl zink with RADV"
	gl_stage
	window_ok
	none 'gpu lost' "$slog" "no gpu lost"
	none 'radeon_hd: gpu hang' "$slog" "no gpu hang"
	manual "GLTeapot from Demos turns; FPS on its card: ____"
	manual "look: pointer stays visible while a window moves"
	emit "INFO window files: $(cd "$home" && ls win-*.txt 2>/dev/null | tr '
' ' ')"
	;;
2)
	exactly 1 'radeon_hd: gpu hang ring' "$slog" "one gpu hang"
	have 'radeon_hd: gpu reset mode2 ok' "$slog" "gpu reset mode2 ok"
	have 'radeon_hd: gpu selftest after reset ok' "$slog" "gpu selftest after reset ok"
	contract 2
	none 'gpu off until reboot' "$slog" "no gpu off"
	runlive gl-test "$bin"/r5-gl-test --selftest
	runlive teapot "$bin"/VulkanTeapot --selftest
	have 'compared zink.*RADV.* and llvmpipe' "$keep/gl-test.txt" \
		"after reset: r5-gl-test zink RADV"
	have '^pixels ok max 2' "$keep/gl-test.txt" "after reset: r5-gl-test pixels ok max 2"
	have 'compared .*RADV.* and .*llvmpipe' "$keep/teapot.txt" \
		"after reset: VulkanTeapot on RADV"
	have '^pixels ok max 2' "$keep/teapot.txt" "after reset: VulkanTeapot pixels ok max 2"
	manual "desktop keeps working (move a window): ____"
	;;
3)
	exactly 2 'radeon_hd: gpu hang ring' "$slog" "two gpu hang lines"
	have 'radeon_hd: gpu off until reboot: second hang' "$slog" \
		"gpu off until reboot: second hang"
	runlive gl-test "$bin"/r5-gl-test --selftest
	runlive teapot "$bin"/VulkanTeapot --selftest
	extract_syslog
	awk '/gpu off until reboot/ { on = 1 } on' "$slog" > "$keep/syslog-after-off.txt"
	have 'egl: opengl llvmpipe: gpu not available' "$keep/syslog-after-off.txt" \
		"egl: opengl llvmpipe: gpu not available"
	have '^pixels ok llvmpipe only' "$keep/gl-test.txt" "r5-gl-test pixels ok llvmpipe only"
	have '^pixels ok lavapipe only' "$keep/teapot.txt" "VulkanTeapot pixels ok lavapipe only"
	none 'RADV' "$keep/teapot.txt" "VulkanTeapot on Lavapipe, not RADV"
	manual "desktop keeps working; GLTeapot turns on llvmpipe: ____"
	;;
4)
	have 'radeon_hd: gpu not available: opt-out' "$slog" "gpu not available: opt-out"
	if [ -d "$nodes" ] && [ -n "$(ls "$nodes" 2>/dev/null)" ]; then
		say 1 "no render node"
	else
		say 0 "no render node"
	fi
	runlive gl-test "$bin"/r5-gl-test --selftest
	extract_syslog
	have 'egl: opengl llvmpipe: gpu off' "$slog" "egl: opengl llvmpipe: gpu off"
	have '^pixels ok llvmpipe only' "$keep/gl-test.txt" "r5-gl-test pixels ok llvmpipe only"
	none 'radeon_hd: gpu hang' "$slog" "no gpu hang"
	manual "GLTeapot turns on llvmpipe: ____"
	;;
5)
	# The marker self-test must pass while app_server's copy runs.
	ms=$(sed -n 's/.*mark selftest ok \([0-9][0-9]*\) ms.*/\1/p' "$slog" | head -n 1)
	if [ -n "$ms" ] && [ "$ms" -lt 5000 ]; then
		say 0 "mark selftest ok $ms ms (under 5000)"
	else
		say 1 "mark selftest ok under 5000 ms (got: ${ms:-no ok line})"
	fi
	none 'mark selftest timeout' "$slog" "no mark selftest timeout"
	have 'gpu copy on scanout' "$slog" "gpu copy on scanout"
	none 'gpu copy off' "$slog" "no gpu copy off"
	contract 1
	none 'gpu lost' "$slog" "no gpu lost"
	manual "desktop still running (move a window): ____"
	;;
6)
	exactly 1 'app_server: gpu copy off: forced failure' "$slog" \
		"gpu copy off: forced failure, once"
	contract 1
	none 'gpu lost' "$slog" "no gpu lost"
	manual "desktop still running (move a window): ____"
	;;
esac
fi

# The shutdown of the boot before, measured by boot-next's heartbeat.
if [ -f "$m10/shutdown-start" ]; then
	s=$(head -n 1 "$m10/shutdown-start")
	a=$(head -n 1 "$m10/alive" 2>/dev/null)
	was=$(head -n 1 "$m10/shutdown-boot" 2>/dev/null)
	if [ -n "$a" ] && [ "$a" -ge "$s" ] 2>/dev/null; then
		emit "INFO shutdown of boot $was: $((a - s)) s from boot-next to the last heartbeat"
	else
		emit "INFO shutdown of boot $was: not measured (no heartbeat)"
	fi
	mv "$m10/shutdown-start" "$keep/"
	mv "$m10/alive" "$keep/" 2>/dev/null
	rm -f "$m10/shutdown-boot"
fi

if [ "$bad" -eq 0 ]; then
	emit PASS
else
	emit FAIL
fi
# On the stick even after the power button.
sync
echo "check: files in $keep"
[ "$bad" -eq 0 ]
