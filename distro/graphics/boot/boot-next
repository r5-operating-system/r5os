#!/bin/sh
# SPDX-FileCopyrightText: 2026 R5OS Contributors
# SPDX-License-Identifier: MIT
#
# M10 stick: write the radeon_hd settings for the next boot, note the boot
# number in ~/m10/next, restart on y. The settings file belongs to root, so
# it is removed and written again. With no argument the next boot follows
# the order 1, 2, 3, 4. "boot-next 5" is the optional boot with the GPU copy
# of app_server on (the marker self-test must pass), "boot-next 6" the
# optional forced failure of that copy.
# "boot-next 1b" writes the M6 contract settings plus
# gpu_opengl true. Every boot adds gpu_selftest true: Login starts the
# self-test only then, and gpu_hang_test starts after it. Boots 1, 2 and 3
# keep every GPU switch at its default.
#
# The shutdown time: right before the restart a background loop writes the
# time to ~/m10/alive every second. check in the next boot reports the span
# from the start to the last heartbeat that reached the disk.
#
# M11 stick (generated/gpu-m11/BRIEF.md, "Stick (step 6)"): when the
# settings file has gpu_compositor true, or with "boot-next m11", the order
# is M11's: 1, 2, 3, 4, then no settings file at all, so the machine keeps
# no test switch. The note is ~/m11/next. Every M11 boot has
# gpu_compositor true, gpu_debug true and gpu_selftest true (the self-test
# starts gpu_hang_test and prints the kernel bo lines); boot 2 adds
# gpu_compositor_fail true, boot 3 gpu_compositor_lavapipe true, boot 4
# gpu_hang_test 1.
#
# M12 measurement stick (generated/gpu-m12/STICK-PLAN.md): when the
# settings file has gpu_draw true, when ~/m12/next names a boot of 2 or 3,
# or with "boot-next m12", the order is 1, 2, 3, 4, then no settings file.
# Boot 1 is Skia on RADV (gpu_draw true), boot 2 Painter under the
# compositor, boot 3 Skia on Lavapipe. Boot 4 is M11's boot 4 again,
# with M11's settings and note, so check and boot-next treat it as M11
# (the hang while composed, never re-run after the fix in 6829434c46).
#
# M13 stick (generated/m13/STICK-PLAN.md): "boot-next m13" starts it, and
# a settings file with a gpu_m13_boot line continues it: 1, 2, 3, 4, then no
# settings file. Every boot has gpu_draw, gpu_debug and gpu_selftest true.
# Boot 1 is Skia on RADV with every other switch at its default (step 2 on
# RADV, #4324), boot 2 adds the step 3 hardware switches
# (gpu_compositor_scanout, gfx9_wc_gtt) and gpu_app_server, which scanout
# needs for a back buffer on the GPU; boot 3 is Skia on Lavapipe with a
# 128-bit vector width. Boot 4 is boot 3 again: the second Lavapipe start,
# which reuses Mesa's shader cache from boot 3. The note is ~/m13/next.
# gpu_m13_boot is only the marker; nothing reads it but check and this
# script.
#
# For the host tests: R5_HOME and R5_USER_SETTINGS move the paths, BOOT_NEXT_YES=0 never
# restarts.

# finddir gives the Haiku directories; the fallback is for the host tests.
fd() {
	finddir "$1" 2>/dev/null || echo "$2"
}

home=${R5_HOME:-$(fd B_USER_DIRECTORY /boot/home)}
m10=$home/m10
file=${R5_USER_SETTINGS:-$(fd B_USER_SETTINGS_DIRECTORY "$home/config/settings")}/kernel/drivers/radeon_hd
sysfile=${R5_SYSTEM_SETTINGS:-$(fd B_SYSTEM_SETTINGS_DIRECTORY /boot/system/settings)/kernel/drivers/radeon_hd}
mkdir -p "$m10"

# CS35L41 speaker stick (#4482): "boot-next cs35l41" starts it, and a
# cs35l41 settings file with a cs35l41_boot line continues it. Boot 1 is
# the DSP bypass with the volume cap, boot 2 the speaker protection
# firmware (cs35l41_firmware true); after boot 2 the file is removed. The
# radeon_hd settings are not touched. The note is ~/cs35l41/next.
ampfile=$(dirname "$file")/cs35l41
if [ "$1" = cs35l41 ] || { [ -z "$1" ] && [ -f "$ampfile" ] \
		&& grep -q '^cs35l41_boot' "$ampfile"; }; then
	mkdir -p "$home/cs35l41" "$(dirname "$ampfile")"
	cur=1
	if [ "$1" = cs35l41 ]; then
		next=1
	else
		cur=$(sed -n 's/^cs35l41_boot[[:space:]]*\([12]\).*/\1/p' \
			"$ampfile" | head -n 1)
		case $cur in
		1) next=2 ;;
		2) next=done ;;
		*)
			echo "FAIL cs35l41: unknown boot '$cur' in $ampfile"
			exit 1
			;;
		esac
	fi
	rm -f "$ampfile"
	case $next in
	1) printf 'cs35l41_firmware false\ncs35l41_boot 1\n' > "$ampfile" ;;
	2) printf 'cs35l41_firmware true\ncs35l41_boot 2\n' > "$ampfile" ;;
	esac
	# Read the file back: a typo here is a lost boot.
	case $next in
	1) want=false ;;
	2) want=true ;;
	done) want= ;;
	esac
	if [ -n "$want" ]; then
		if ! grep -q "^cs35l41_firmware $want\$" "$ampfile"; then
			echo "FAIL cs35l41: $ampfile does not say cs35l41_firmware $want"
			exit 1
		fi
	elif [ -f "$ampfile" ]; then
		echo "FAIL cs35l41: $ampfile is still there"
		exit 1
	fi
	echo "$next" > "$home/cs35l41/next"
	case $next in
	1) echo "boot-next: next boot is cs35l41 boot 1 (bypass, volume cap)" ;;
	2) echo "boot-next: next boot is cs35l41 boot 2 (speaker protection firmware)" ;;
	done) echo "boot-next: cs35l41 stick done, settings file removed" ;;
	esac
	echo "boot-next: settings file $ampfile"
	if [ "${BOOT_NEXT_YES:-1}" = 0 ]; then
		echo PASS
		exit 0
	fi
	printf 'boot-next: restart? [y] '
	read ans
	if [ "$ans" != y ]; then
		echo "FAIL not restarted (the settings are written)"
		exit 1
	fi
	echo PASS
	sync
	if ! shutdown -r; then
		echo "FAIL shutdown -r did not start"
		exit 1
	fi
	exit 0
fi

# Display register paths (docs/DISPLAY-DCN.md, "Register access"):
# "boot-next dcnpath" starts it, and a radeon_hd settings file with a
# dcn_path_boot line continues it. One diagnostic path per boot, the one
# Linux itself uses at init first: boot 1 dcn_probe_path discovery, boot 2
# mm_index, boot 3 pcie_index2; then the file is removed. The accelerant
# arms the crash marker with the path's name before the access, so a boot
# that hangs is named by the next start ("did not finish step path-...").
# Before each step the dcn lines of the boot that ran are saved in
# ~/dcnpath/boot<n>.txt. The note is ~/dcnpath/next.
if [ "$1" = dcnpath ] || { [ -z "$1" ] && [ -f "$file" ] \
		&& grep -q '^dcn_path_boot' "$file"; }; then
	dp=$home/dcnpath
	mkdir -p "$dp" "$(dirname "$file")"
	if [ "$1" = dcnpath ]; then
		cur=0
		next=1
	else
		cur=$(sed -n 's/^dcn_path_boot[[:space:]]*\([123]\).*/\1/p' \
			"$file" | head -n 1)
		case $cur in
		1) next=2 ;;
		2) next=3 ;;
		3) next=done ;;
		*)
			echo "FAIL dcnpath: unknown boot '$cur' in $file"
			exit 1
			;;
		esac
	fi
	if [ "$cur" != 0 ]; then
		grep -E 'radeon_hd: dcn' "${R5_SYSLOG:-/var/log/syslog}" \
			> "$dp/boot$cur.txt" 2>/dev/null
		echo "boot-next: saved $(wc -l < "$dp/boot$cur.txt") lines in" \
			"$dp/boot$cur.txt"
	fi
	rm -f "$file"
	case $next in
	1) want=discovery ;;
	2) want=mm_index ;;
	3) want=pcie_index2 ;;
	done) want= ;;
	esac
	if [ -n "$want" ]; then
		{
			echo "dcn_probe_path $want"
			echo "dcn_path_boot $next"
		} > "$file"
		# Read the file back: a typo here is a lost boot.
		if ! grep -q "^dcn_probe_path $want\$" "$file"; then
			echo "FAIL dcnpath: $file does not say dcn_probe_path $want"
			exit 1
		fi
	elif [ -f "$file" ]; then
		echo "FAIL dcnpath: $file is still there"
		exit 1
	fi
	echo "$next" > "$dp/next"
	if [ -n "$want" ]; then
		echo "boot-next: next boot is dcnpath boot $next ($want)"
	else
		echo "boot-next: dcnpath done, settings file removed"
	fi
	echo "boot-next: settings file $file"
	if [ "${BOOT_NEXT_YES:-1}" = 0 ] || [ "$next" = done ]; then
		echo PASS
		exit 0
	fi
	printf 'boot-next: restart? [y] '
	read ans
	if [ "$ans" != y ]; then
		echo "FAIL not restarted (the settings are written)"
		exit 1
	fi
	echo PASS
	sync
	if ! shutdown -r; then
		echo "FAIL shutdown -r did not start"
		exit 1
	fi
	exit 0
fi

# Display SMU/clock/DCCG read-only diagnostics (docs/DISPLAY-DCN.md, round 1):
# "boot-next dcndiag" starts it, and a radeon_hd settings file with a
# dcn_diag_boot line continues it. One read-only path per boot, behind the
# crash marker: boot 1 smu_status (MP1 mailboxes + SMUIO), boot 2 clk_status
# (CLK1 display clocks), boot 3 dccg_seg1 (DMU seg 1 DENTIST_DISPCLK_CNTL);
# then the settings file is removed. Before each step the dcn lines of the
# boot that ran are saved in ~/dcndiag/boot<n>.txt.
if [ "$1" = dcndiag ] || { [ -z "$1" ] && [ -f "$file" ] \
		&& grep -q '^dcn_diag_boot' "$file"; }; then
	dd=$home/dcndiag
	mkdir -p "$dd" "$(dirname "$file")"
	if [ "$1" = dcndiag ]; then
		cur=0
		next=1
	else
		cur=$(sed -n 's/^dcn_diag_boot[[:space:]]*\([123]\).*/\1/p' \
			"$file" | head -n 1)
		case $cur in
		1) next=2 ;;
		2) next=3 ;;
		3) next=done ;;
		*)
			echo "FAIL dcndiag: unknown boot '$cur' in $file"
			exit 1
			;;
		esac
	fi
	if [ "$cur" != 0 ]; then
		grep -E 'radeon_hd: dcn' "${R5_SYSLOG:-/var/log/syslog}" \
			> "$dd/boot$cur.txt" 2>/dev/null
		echo "boot-next: saved $(wc -l < "$dd/boot$cur.txt") lines in" \
			"$dd/boot$cur.txt"
	fi
	rm -f "$file"
	case $next in
	1) want=smu_status ;;
	2) want=clk_status ;;
	3) want=dccg_seg1 ;;
	done) want= ;;
	esac
	if [ -n "$want" ]; then
		{
			echo "dcn_probe_path $want"
			echo "dcn_diag_boot $next"
		} > "$file"
		# Read the file back: a typo here is a lost boot.
		if ! grep -q "^dcn_probe_path $want\$" "$file"; then
			echo "FAIL dcndiag: $file does not say dcn_probe_path $want"
			exit 1
		fi
	elif [ -f "$file" ]; then
		echo "FAIL dcndiag: $file is still there"
		exit 1
	fi
	echo "$next" > "$dd/next"
	if [ -n "$want" ]; then
		echo "boot-next: next boot is dcndiag boot $next ($want)"
	else
		echo "boot-next: dcndiag done, settings file removed"
	fi
	echo "boot-next: settings file $file"
	if [ "${BOOT_NEXT_YES:-1}" = 0 ] || [ "$next" = done ]; then
		echo PASS
		exit 0
	fi
	printf 'boot-next: restart? [y] '
	read ans
	if [ "$ans" != y ]; then
		echo "FAIL not restarted (the settings are written)"
		exit 1
	fi
	echo PASS
	sync
	if ! shutdown -r; then
		echo "FAIL shutdown -r did not start"
		exit 1
	fi
	exit 0
fi

# HDMI display stick (docs/DISPLAY-DCN.md, PR 4712): "boot-next hdmi"
# starts it, and a radeon_hd settings file with a dcn_hdmi_boot line
# continues it. Before each step the dcn lines of the boot that ran are saved
# in ~/hdmi/boot<n>.txt. Boot 1 has every switch at its default: the step 1
# probe and the step 2a pipe log run, nothing is shown on HDMI. Boot 2 adds
# dcn_hdmi_modeset true: colour squares on HDMI, the panel unchanged. Boot 3
# is display step 4: multi_screen true with a test screen in memory right of
# the panel (multi_screen_test_output 1280x720); the desktop spans both. Its
# picture, /tmp/r5-screen-1.ppm, is copied to ~/hdmi/screen-1.ppm. After
# boot 3 the file is removed. The note is ~/hdmi/next.
if [ "$1" = hdmi ] || { [ -z "$1" ] && [ -f "$file" ] \
		&& grep -q '^dcn_hdmi_boot' "$file"; }; then
	hd=$home/hdmi
	mkdir -p "$hd" "$(dirname "$file")"
	if [ "$1" = hdmi ]; then
		cur=0
		next=1
	else
		cur=$(sed -n 's/^dcn_hdmi_boot[[:space:]]*\([123]\).*/\1/p' \
			"$file" | head -n 1)
		case $cur in
		1) next=2 ;;
		2) next=3 ;;
		3) next=done ;;
		*)
			echo "FAIL hdmi: unknown boot '$cur' in $file"
			exit 1
			;;
		esac
	fi
	if [ "$cur" != 0 ]; then
		grep -E 'radeon_hd: dcn' "${R5_SYSLOG:-/var/log/syslog}" \
			> "$hd/boot$cur.txt" 2>/dev/null
		echo "boot-next: saved $(wc -l < "$hd/boot$cur.txt") lines in" \
			"$hd/boot$cur.txt"
		if [ "$cur" = 3 ]; then
			grep -E 'multi_screen|screen output' \
				"${R5_SYSLOG:-/var/log/syslog}" >> "$hd/boot3.txt" 2>/dev/null
			cp "${R5_SCREEN_DUMP:-/tmp/r5-screen-1.ppm}" \
				"$hd/screen-1.ppm" 2>/dev/null \
				&& echo "boot-next: saved $hd/screen-1.ppm"
		fi
	fi
	rm -f "$file"
	case $next in
	1) printf 'dcn_hdmi_boot 1\n' > "$file" ;;
	2) printf 'dcn_hdmi_modeset true\ndcn_hdmi_boot 2\n' > "$file" ;;
	3)
		{
			echo 'multi_screen true'
			echo 'multi_screen_test_output 1280x720'
			echo 'dcn_hdmi_boot 3'
		} > "$file"
		;;
	esac
	# Read the file back: a typo here is a lost boot.
	case $next in
	1)
		if ! grep -q '^dcn_hdmi_boot 1$' "$file" \
			|| grep -q dcn_hdmi_modeset "$file"; then
			echo "FAIL hdmi: $file is not boot 1"
			exit 1
		fi
		;;
	2)
		if ! grep -q '^dcn_hdmi_modeset true$' "$file"; then
			echo "FAIL hdmi: $file does not say dcn_hdmi_modeset true"
			exit 1
		fi
		;;
	3)
		if ! grep -q '^multi_screen true$' "$file" \
			|| ! grep -q '^multi_screen_test_output 1280x720$' "$file" \
			|| grep -q dcn_hdmi_modeset "$file"; then
			echo "FAIL hdmi: $file is not boot 3"
			exit 1
		fi
		;;
	done)
		if [ -f "$file" ]; then
			echo "FAIL hdmi: $file is still there"
			exit 1
		fi
		;;
	esac
	echo "$next" > "$hd/next"
	case $next in
	1) echo "boot-next: next boot is hdmi boot 1 (hotplug, EDID, pipe log)" ;;
	2) echo "boot-next: next boot is hdmi boot 2 (dcn_hdmi_modeset true)" ;;
	3) echo "boot-next: next boot is hdmi boot 3 (multi_screen, test screen)" ;;
	done) echo "boot-next: hdmi stick done, settings file removed" ;;
	esac
	echo "boot-next: settings file $file"
	if [ "${BOOT_NEXT_YES:-1}" = 0 ] || [ "$next" = done ]; then
		echo PASS
		exit 0
	fi
	printf 'boot-next: restart? [y] '
	read ans
	if [ "$ans" != y ]; then
		echo "FAIL not restarted (the settings are written)"
		exit 1
	fi
	echo PASS
	sync
	if ! shutdown -r; then
		echo "FAIL shutdown -r did not start"
		exit 1
	fi
	exit 0
fi

# Round 3 stick (stick 75: #4499 Power, #4496 card reader, #4553
# microcode): one boot with every GPU switch at its default. The planted
# radeon_hd file only has r5_round3_boot, so a plain "boot-next" saves the
# results of the boot that runs now in ~/round3/<n>-*.txt (n counts the
# runs, so a second computer does not overwrite the first) and does not
# restart. The file stays: a later "boot-next" on this stick only saves
# again. "boot-next round3" writes the marker again.
if [ "$1" = round3 ] || { [ -z "$1" ] && [ -f "$file" ] \
		&& grep -q '^r5_round3_boot' "$file"; }; then
	r3=$home/round3
	mkdir -p "$r3" "$(dirname "$file")"
	if [ "$1" = round3 ]; then
		rm -f "$file"
		printf 'r5_round3_boot 1\n' > "$file"
		if ! grep -q '^r5_round3_boot 1$' "$file"; then
			echo "FAIL round3: $file does not say r5_round3_boot 1"
			exit 1
		fi
		echo "boot-next: round 3 marker written; start again, then boot-next"
		echo PASS
		exit 0
	fi
	n=1
	while [ -e "$r3/$n-power.txt" ]; do
		n=$((n + 1))
	done
	log=${R5_SYSLOG:-/var/log/syslog}
	{
		echo "== computer"
		sysinfo -cpu 2>&1 | head -n 8
		echo "== syslog"
		grep -E 'ucode|microcode|revision 0x' "$log" 2>/dev/null | head -n 40
	} > "$r3/$n-ucode.txt"
	{
		echo "== syslog"
		grep -E 'acpi_ac|acpi_battery|power_daemon|R5 CPPC|brightness|transmitter_dig_setup|AtomBIOS stuck|parser was aborted' \
			"$log" 2>/dev/null | tail -n 80
		echo "== AC now (1 is plugged in)"
		od -An -tu1 -N1 /dev/power/acpi_ac/0 2>&1
		echo "== Deskbar items"
		reps=$home/config/settings/deskbar/replicants
		if [ -f "$reps" ]; then
			tr -c '[:print:]' '\n' < "$reps" | grep -E '^/' | head -n 20
		else
			echo "no $reps"
		fi
		echo "== /boot/system/settings/power"
		cat /boot/system/settings/power 2>&1
		echo "== /dev/power"
		ls -R /dev/power 2>&1
	} > "$r3/$n-power.txt"
	{
		echo "== syslog"
		grep -E 'rtsx|mmc' "$log" 2>/dev/null | tail -n 60
		echo "== /dev/disk/mmc"
		ls -R /dev/disk/mmc 2>&1
		for raw in /dev/disk/mmc/*/raw; do
			[ -e "$raw" ] || continue
			echo "== read 8 MB from $raw"
			start=$(date +%s)
			dd if="$raw" of=/dev/null bs=1048576 count=8 2>&1
			echo "read seconds $(( $(date +%s) - start ))"
		done
		# Removable volumes are mounted on insert; if not, mount the first
		# partition here.
		if ! df 2>/dev/null | grep -q '/dev/disk/mmc'; then
			for part in /dev/disk/mmc/*/[0-9]*; do
				[ -e "$part" ] || continue
				mkdir -p /r5card
				echo "== mount $part on /r5card"
				mount "$part" /r5card 2>&1 && break
			done
		fi
		echo "== df"
		df 2>&1
		# R5's df prints the mount point on its own line (in bold) and the
		# device on the next one.
		# A FAT card is often "NO NAME": keep the whole line.
		df 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' \
			| awk '/^\// {vol = $0; sub(/[ \t]+$/, "", vol)}
				$NF ~ /^\/dev\/disk\/mmc/ {print vol}' > "$r3/volumes"
		while IFS= read -r vol; do
			t=$vol/r5-card-test.txt
			echo "== write test on $vol"
			if dd if=/dev/urandom of="$t" bs=1048576 count=1 2>/dev/null \
					&& sync && cp "$t" "$r3/card.bin" && cmp "$t" "$r3/card.bin"; then
				echo "card write+read ok"
			else
				echo "card write+read FAIL"
			fi
			rm -f "$t" "$r3/card.bin"
		done < "$r3/volumes"
		rm -f "$r3/volumes"
	} > "$r3/$n-card.txt" 2>&1
	sync
	echo "boot-next: round 3 results saved as ~/round3/$n-*.txt"
	grep -h -E 'updated from|already at|no update found' "$r3/$n-ucode.txt" | head -n 2
	grep -h -E 'card write\+read' "$r3/$n-card.txt"
	echo "PASS (shut down when you like)"
	exit 0
fi

# M11: the settings of the boot that just ran say so, or "boot-next m11".
# M12 first: its boots 2 and 3 have no gpu_compositor line, boot 4 does.
stick=m10
start11=0
m12note=$home/m12/next
# M13 follow-up (19 Nov 2026): "boot-next m13f" starts it, and a settings
# file with gpu_m13f_boot continues it. One switch per boot. Boot 1 is the
# defaults (Skia on, 2 MB areas). Boot 2 adds gpu_compositor_scanout, and
# gpu_app_server because scanout copies that back buffer. Boot 3 turns
# scanout off and adds gfx9_wc_gtt. Boot 4 is gpu false (Lavapipe and
# Skia). Boot 5 is the defaults again, and the warm-up waits 8 s
# (gpu_draw_settle) so it starts after the USB drivers. gpu_debug is on
# every boot so m13-measure can read the 10 s lines.
if [ "$1" = m13f ]; then
	stick=m13f
	start11=1
	set -- 1
elif [ -f "$file" ] && grep -q '^gpu_m13f_boot' "$file"; then
	stick=m13f
elif [ "$1" = m13 ]; then
	stick=m13
	start11=1
	set -- 1
elif [ -f "$file" ] && grep -q '^gpu_m13_boot' "$file"; then
	stick=m13
elif [ "$1" = m12 ]; then
	stick=m12
	start11=1
	set -- 1
elif [ -f "$file" ] && grep -q '^gpu_draw true' "$file" \
		&& ! grep -q '^gpu_compositor true' "$file"; then
	stick=m12
elif [ -f "$m12note" ] && grep -Eq '^(2|3)$' "$m12note" \
		&& ! { [ -f "$file" ] && grep -q '^gpu_compositor true' "$file"; }; then
	stick=m12
elif [ "$1" = m11 ]; then
	stick=m11
	start11=1
	set -- 1
elif [ -f "$file" ] && grep -q '^gpu_compositor true' "$file"; then
	stick=m11
fi
if [ "$stick" = m11 ]; then
	m10=$home/m11
	mkdir -p "$m10"
fi
if [ "$stick" = m12 ]; then
	m10=$home/m12
	mkdir -p "$m10"
fi
if [ "$stick" = m13 ]; then
	m10=$home/m13
	mkdir -p "$m10"
fi
if [ "$stick" = m13f ]; then
	m10=$home/m13f
	mkdir -p "$m10"
fi

# The boot that just ran: the note, else no note means boot 1.
cur=1
if [ -f "$m10/next" ]; then
	cur=$(head -n 1 "$m10/next" | tr -d ' \r')
fi

if [ "$stick" = m13f ]; then
	if [ -n "$1" ]; then
		next=$1
	else
		case $cur in
		1) next=2 ;;
		2) next=3 ;;
		3) next=4 ;;
		4) next=5 ;;
		5) next=done ;;
		*)
			echo "FAIL no M13 follow-up boot follows $cur; run boot-next m13f"
			exit 1
			;;
		esac
	fi
elif [ "$stick" = m13 ]; then
	if [ -n "$1" ]; then
		next=$1
	else
		case $cur in
		1) next=2 ;;
		2) next=3 ;;
		3) next=4 ;;
		4) next=done ;;
		*)
			echo "FAIL no M13 boot follows $cur; run boot-next <1|2|3|4|done>"
			exit 1
			;;
		esac
	fi
elif [ "$stick" = m12 ]; then
	if [ -n "$1" ]; then
		next=$1
	else
		case $cur in
		1) next=2 ;;
		2) next=3 ;;
		3) next=4 ;;
		*)
			echo "FAIL no M12 boot follows $cur; run boot-next <1|2|3|4|done>"
			exit 1
			;;
		esac
	fi
elif [ "$stick" = m11 ]; then
	if [ -n "$1" ]; then
		next=$1
	else
		case $cur in
		1) next=2 ;;
		2) next=3 ;;
		3) next=4 ;;
		4) next=done ;;
		*)
			echo "FAIL no M11 boot follows $cur; run boot-next <1|2|3|4|done>"
			exit 1
			;;
		esac
	fi
elif [ -n "$1" ]; then
	next=$1
else
	case $cur in
	1|1b) next=2 ;;
	2) next=3 ;;
	3) next=4 ;;
	*)
		echo "FAIL no boot follows $cur; run boot-next <1|1b|2|3|4|5|6>"
		exit 1
		;;
	esac
fi

# The boot that just ran must have been checked. Its files are the record.
done_check=0
for d in "$m10/boot$cur" "$m10/boot$cur"-*; do
	if [ -f "$d/check.txt" ]; then
		done_check=1
	fi
done
if [ "$done_check" -ne 1 ] && [ "$start11" != 1 ] && [ "$stick" != m13f ]; then
	echo "FAIL run check first (no check.txt for boot $cur in $m10)"
	exit 1
fi

m11="gpu_compositor true
gpu_debug true
gpu_selftest true"
m12="gpu_debug true
gpu_selftest true"
m13="gpu_draw true
gpu_debug true
gpu_selftest true"
m13f="gpu_debug true"
if [ "$stick" = m13f ]; then
	case $next in
	1) lines="$m13f
gpu_m13f_boot 1" ;;
	2) lines="$m13f
gpu_app_server true
gpu_compositor_scanout true
gpu_m13f_boot 2" ;;
	3) lines="$m13f
gfx9_wc_gtt true
gpu_m13f_boot 3" ;;
	4) lines="$m13f
gpu false
gpu_m13f_boot 4" ;;
	5) lines="$m13f
gpu_draw_settle true
gpu_m13f_boot 5" ;;
	done) lines= ;;
	*)
		echo "FAIL unknown M13 follow-up boot $next (1, 2, 3, 4, 5 or done)"
		exit 1
		;;
	esac
elif [ "$stick" = m13 ]; then
	case $next in
	1) lines="$m13
gpu_m13_boot 1" ;;
	2) lines="$m13
gpu_app_server true
gpu_compositor_scanout true
gfx9_wc_gtt true
gpu_m13_boot 2" ;;
	3) lines="$m13
gpu_compositor_lavapipe true
gpu_lavapipe_vector 128
gpu_m13_boot 3" ;;
	4) lines="$m13
gpu_compositor_lavapipe true
gpu_lavapipe_vector 128
gpu_m13_boot 4" ;;
	done) lines= ;;
	*)
		echo "FAIL unknown M13 boot $next (1, 2, 3, 4 or done)"
		exit 1
		;;
	esac
elif [ "$stick" = m12 ]; then
	case $next in
	1) lines="gpu_draw true
$m12" ;;
	2) lines=$m12 ;;
	3) lines="gpu_draw true
gpu_compositor_lavapipe true
$m12" ;;
	4) lines="$m11
gpu_hang_test 1"
		# M11's own note: check and boot-next read boot 4 as M11's.
		mkdir -p "$home/m11"
		echo 4 > "$home/m11/next" ;;
	done) lines= ;;
	*)
		echo "FAIL unknown M12 boot $next (1, 2, 3, 4 or done)"
		exit 1
		;;
	esac
elif [ "$stick" = m11 ]; then
	case $next in
	1) lines=$m11 ;;
	2) lines="$m11
gpu_compositor_fail true" ;;
	3) lines="$m11
gpu_compositor_lavapipe true" ;;
	4) lines="$m11
gpu_hang_test 1" ;;
	done) lines= ;;
	*)
		echo "FAIL unknown M11 boot $next (1, 2, 3, 4 or done)"
		exit 1
		;;
	esac
else
case $next in
1) lines="gpu_selftest true" ;;
1b) lines="gfx9_ring true
gfx9_kernel true
gfx9_irq true
gfx9_gart true
gpu_render true
gpu_selftest true
gfx9_vmids true
gfx9_vmid_per_file true
gfx9_pasid_map true
gpu_present true
gpu_opengl true" ;;
2) lines="gpu_selftest true
gpu_hang_test 1" ;;
3) lines="gpu_selftest true
gpu_hang_test 2" ;;
4) lines="gpu false
gpu_selftest true" ;;
5|6) lines="gfx9_ring true
gfx9_kernel true
gfx9_irq true
gfx9_gart true
gpu_render true
gpu_selftest true
gfx9_vmids true
gfx9_vmid_per_file true
gfx9_pasid_map true
gpu_present true
gpu_app_server true"
	if [ "$next" = 6 ]; then
		lines="$lines
gpu_app_server_fail true"
	fi ;;
*)
	echo "FAIL unknown boot $next (1, 1b, 2, 3, 4, 5 or 6)"
	exit 1
	;;
esac
fi

echo "boot-next: remove the settings file"
rm -f "$file"
if [ -f "$file" ]; then
	echo FAIL
	exit 1
fi
if [ -f "$sysfile" ]; then
	echo "boot-next: note, $sysfile exists and is read too"
fi
if [ -n "$lines" ]; then
	echo "boot-next: write the settings for boot $next"
	mkdir -p "$(dirname "$file")"
	printf '%s\n' "$lines" > "$file"
	if [ ! -s "$file" ]; then
		echo FAIL
		exit 1
	fi
	cat "$file"
else
	echo "boot-next: boot $next uses no settings file"
fi
echo "$next" > "$m10/next"
echo "boot-next: boot $next is next"
if [ "$stick" = m13f ]; then
	case $next in
	1) echo "boot-next: next boot is defaults (Skia on, 2 MB areas)" ;;
	2) echo "boot-next: next boot adds scanout (and the GPU back buffer it copies)" ;;
	3) echo "boot-next: next boot is write-combined GTT, scanout off" ;;
	4) echo "boot-next: next boot is gpu false (Lavapipe and Skia)" ;;
	5) echo "boot-next: next boot waits 8 s before the Skia warm-up" ;;
	done) echo "boot-next: next boot clears the settings" ;;
	esac
	echo "boot-next: settings file $file"
fi

if [ "${BOOT_NEXT_YES:-1}" = 0 ]; then
	echo PASS
	exit 0
fi
printf 'boot-next: restart? [y] '
read ans
if [ "$ans" = y ]; then
	echo PASS
	rm -f "$m10/alive"
	date +%s > "$m10/shutdown-start"
	echo "$cur" > "$m10/shutdown-boot"
	sync
	# Each beat is synced, or it never reaches the stick (M10 round 5:
	# "not measured (no heartbeat)").
	( while :; do date +%s > "$m10/alive"; sync; sleep 1; done ) > /dev/null 2>&1 &
	beat=$!
	if ! shutdown -r; then
		kill "$beat"
		rm -f "$m10/shutdown-start" "$m10/alive" "$m10/shutdown-boot"
		echo "FAIL shutdown -r did not start"
		exit 1
	fi
else
	echo "FAIL not restarted (the settings are written)"
	exit 1
fi
