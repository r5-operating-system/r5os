#!/bin/sh
# SPDX-FileCopyrightText: 2026 R5OS Contributors
# SPDX-License-Identifier: MIT
#
# M10 stick, last step of boot 1: the short test for the standard account.
# Sign in as that account, run check-user, sign out. The account runs:
#   r5-gl-test --selftest       Zink with pixels ok
#   VulkanTeapot --selftest     pixels ok
#   r5-gpu-isolation            a write to another program's address that
#                               faults in the account's own VMID (M5)
# The files go to ~/m10/user-<account>/ in the account's own home, so a
# standard account can write them. read-stick-logs.py copies ~/m10 of the
# administrator and of every account under /boot/home/users.
#
# M11 stick (optional, end of boot 1): when the administrator's radeon_hd
# settings have gpu_compositor true, check-user runs the M11 part instead:
# VulkanTeapot of a standard account shares without a copy, and
# r5-share-check passes as that account. Files in ~/m11/user-<account>.
#
# For the host tests: CHECK_LIVE=0 runs no program, R5_ADMIN_SETTINGS
# moves the administrator's settings file.

who=$(id -un 2>/dev/null || echo unknown)
home=${R5_HOME:-$HOME}
stick=m10
admin=${R5_ADMIN_SETTINGS:-/boot/home/config/settings/kernel/drivers/radeon_hd}
if grep -q '^gpu_compositor true' "$admin" 2>/dev/null; then
	stick=m11
fi
keep=$home/$stick/user-$who
mkdir -p "$keep"
report=$keep/check-user.txt
: > "$report"
bad=0
live=${CHECK_LIVE:-1}
bin=${R5_BIN:-/bin}
syslog=${R5_SYSLOG:-/boot/system/var/log/syslog}

emit() {
	printf '%s\n' "$1" | tee -a "$report"
}
say() {
	if [ "$1" -eq 0 ]; then
		emit "PASS $2"
	else
		emit "FAIL $2"
		bad=1
	fi
}
have() {
	if [ -s "$2" ] && grep -Eq -- "$1" "$2"; then
		say 0 "$3"
	else
		say 1 "$3"
	fi
}
none() {
	if [ -s "$2" ] && ! grep -Eq -- "$1" "$2"; then
		say 0 "$3"
	else
		say 1 "$3"
	fi
}
runlive() {
	name=$1
	shift
	: > "$keep/$name.txt"
	if [ "$live" -eq 1 ]; then
		# R5_GL_TRACE and RADV_DEBUG=startup say how far a program got.
		start=$(date +%s)
		R5_GL_TRACE=1 RADV_DEBUG=startup timeout 180 "$@" > "$keep/$name.txt" 2>&1
		rc=$?
		echo "exit $rc after $(( $(date +%s) - start )) s" >> "$keep/$name.txt"
		if [ "$rc" -eq 124 ]; then
			# The kernel's view of the GPU when the program did not finish.
			grep 'radeon_hd' "$syslog" 2>/dev/null | tail -n 60 				> "$keep/$name-syslog.txt"
		fi
		sync
	fi
}

emit "check-user: account $who, uid $(id -u 2>/dev/null)"
if [ "$(id -u 2>/dev/null)" = 0 ]; then
	say 1 "account is a standard account (this one is uid 0)"
else
	say 0 "account is a standard account"
fi

if [ "$stick" = m11 ]; then
	from=$(wc -l < "$syslog" 2>/dev/null | tr -d ' ')
	first=$(head -n 1 "$syslog" 2>/dev/null | cksum)
	runlive teapot "$bin"/VulkanTeapot --window --seconds 15
	# M11 fourth review: a syslog rotated meanwhile is read on from
	# syslog.1.
	if [ "$first" != "$(head -n 1 "$syslog" 2>/dev/null | cksum)" ] \
		&& [ -f "$syslog.1" ]; then
		{ tail -n +"$((${from:-0} + 1))" "$syslog.1"; cat "$syslog"; } \
			> "$keep/teapot-syslog.txt" 2>/dev/null
	else
		tail -n +"$((${from:-0} + 1))" "$syslog" > "$keep/teapot-syslog.txt" 2>/dev/null
	fi
	have '^window fps [0-9]' "$keep/teapot.txt" "VulkanTeapot: window fps line"
	have 'app_server: window [0-9]+ zero-copy on' "$keep/teapot-syslog.txt" \
		"VulkanTeapot of a standard account: zero-copy on"
	runlive share "$bin"/r5-share-check
	have 'app_server as a user refused: pass' "$keep/share.txt" \
		"r5-share-check: argv[0] app_server as a user refused: pass"
	have 'not app_server refused: pass' "$keep/share.txt" \
		"r5-share-check: import by a program that is not app_server refused: pass"
	have 'same number refused: pass' "$keep/share.txt" \
		"r5-share-check: second import of the same number refused: pass"
	none ': fail' "$keep/share.txt" "r5-share-check: no fail"
	if [ "$bad" -eq 0 ]; then
		emit PASS
	else
		emit FAIL
	fi
	sync
	echo "check-user: files in $keep"
	[ "$bad" -eq 0 ]
	exit
fi

runlive gl-test "$bin"/r5-gl-test --selftest
have 'compared zink.*RADV.* and llvmpipe' "$keep/gl-test.txt" "r5-gl-test: compared zink RADV and llvmpipe"
have '^pixels ok max 2' "$keep/gl-test.txt" "r5-gl-test: pixels ok max 2"

runlive teapot "$bin"/VulkanTeapot --selftest
have 'compared .*RADV.* and .*llvmpipe' "$keep/teapot.txt" "VulkanTeapot: compared RADV and llvmpipe"
have '^pixels ok max 2' "$keep/teapot.txt" "VulkanTeapot: pixels ok max 2"
none 'pixels MISMATCH' "$keep/teapot.txt" "VulkanTeapot: no pixels MISMATCH"

# The isolation program: the owner's buffer stays unchanged, and the other
# account's write faults in its own VMID. "vm fault not in syslog" means
# the fault was not seen, which is not a pass.
runlive isolation "$bin"/r5-gpu-isolation
have '^owner unchanged' "$keep/isolation.txt" "isolation: owner unchanged"
have '^vm fault addr ' "$keep/isolation.txt" "isolation: vm fault in the syslog"
none 'vm fault not in syslog' "$keep/isolation.txt" "isolation: the fault was seen"
have '^owner ok client' "$keep/isolation.txt" "isolation: owner ok"
have '^exit 0' "$keep/isolation.txt" "isolation: exit 0"

if [ "$bad" -eq 0 ]; then
	emit PASS
else
	emit FAIL
fi
# On the stick even after the power button.
sync
echo "check-user: files in $keep"
[ "$bad" -eq 0 ]
