#
# M11 stick, the scenario: a long output in this Terminal to scroll for
# 20 s (about 20 000 lines, nothing written to the stick).

find /boot/system -print 2>/dev/null | head -n 20000
echo "m11-scroll: done; scroll this output up and down for 20 s"
