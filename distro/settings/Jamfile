SubDir HAIKU_TOP src preferences settings ;

UsePrivateHeaders interface shared app net r5gpu ;
# The Power page: <PowerProtocol.h>, <syscalls.h> and <driver_settings.h>.
UsePrivateHeaders power ;
UsePrivateSystemHeaders ;

# Connections and Discovery use the address field, the link speed and the
# service add-on classes of the Network program, unchanged
# (src/preferences/network, src/bin/network/ifconfig).
UsePublicHeaders [ FDirName add-ons network_settings ] ;
SubDirHdrs $(HAIKU_TOP) src preferences network ;
SubDirHdrs $(HAIKU_TOP) src bin network ifconfig ;
SEARCH_SOURCE += [ FDirName $(HAIKU_TOP) src preferences network ] ;

Application Settings :
	SettingsApp.cpp
	SettingsWindow.cpp
	SettingsManager.cpp
	SettingsStorage.cpp
	SettingsHost.cpp
	HomeView.cpp
	SettingsFont.cpp
	SettingsIcon.cpp
	LegacyPages.cpp
	WallpaperModule.cpp
	DeskbarModule.cpp
	ThemeModule.cpp
	NotificationsModule.cpp
	VirtualMemoryModule.cpp
	PowerModule.cpp
	InformationModule.cpp
	DisplayModule.cpp
	DisplayScreens.cpp
	WiFiModule.cpp
	ConnectionsModule.cpp
	DiscoveryModule.cpp
	NetworkPage.cpp
	IPAddressControl.cpp
	NetworkSettingsAddOn.cpp
	ServiceListItem.cpp
	ServiceView.cpp
	: <src!bin!network!ifconfig>MediaTypes.o
		be tracker translation shared libr5icons.so libr5ui.so libr5wifi.so
		libr5power.so
		bnetapi network [ TargetLibstdc++ ] localestub
	: Settings.rdef
	;

# The Bluetooth page (docs/BLUETOOTH.md, step 3a). An add-on, so Settings
# itself does not need libr5bt.so and libbluetooth.so, which only the regular
# image ships.
Addon settings_bluetooth :
	BluetoothModule.cpp
	SettingsFont.cpp
	: be shared localestub libr5bt.so [ TargetLibstdc++ ]
	;

# The Game controllers page (docs/GAME-CONTROLLERS.md, option B). An add-on
# like the Bluetooth page, so Settings itself does not link libr5game.so.
# It shares the filled box, its title and the link with Connections.
Addon settings_gamecontrollers :
	GameControllersModule.cpp
	NetworkPage.cpp
	SettingsFont.cpp
	: be shared localestub libr5ui.so libr5icons.so libr5game.so
		[ TargetLibstdc++ ]
	;

Addon settings_fonts :
	FontsModule.cpp
	FontView.cpp
	FontSelectionView.cpp
	AntialiasingSettingsView.cpp
	SettingsFont.cpp
	: be shared localestub libr5ui.so [ TargetLibstdc++ ]
	;

Addon settings_look :
	LookModule.cpp
	LookAndFeelSettingsView.cpp
	FakeScrollBar.cpp
	ColorsView.cpp
	Colors.cpp
	SettingsFont.cpp
	WindowEffectsBox.cpp
	: be shared localestub libr5ui.so [ TargetLibstdc++ ]
	;
