SubDir HAIKU_TOP src preferences settings ;

UsePrivateHeaders interface shared app net r5gpu ;
# The Power page: <PowerProtocol.h>, <syscalls.h> and <driver_settings.h>.
UsePrivateHeaders power ;
UsePrivateSystemHeaders ;

# Settings and each page add-on have a catalog of their own
# (docs/TRANSLATIONS.md), in objects/catalogs/preferences/settings/<target>.
HAIKU_MULTIPLE_LOCALIZED_TARGETS on $(SUBDIR) = 1 ;

# Connections and Discovery use the address field, the link speed and the
# service add-on classes of the Network program, unchanged
# (src/preferences/network, src/bin/network/ifconfig).
UsePublicHeaders [ FDirName add-ons network_settings ] ;
SubDirHdrs $(HAIKU_TOP) src preferences network ;
SubDirHdrs $(HAIKU_TOP) src bin network ifconfig ;
# Users and Accounts uses the request codes of AccountAdmin.h (src/preferences
# users); only the header, no code of that program.
SubDirHdrs $(HAIKU_TOP) src preferences users ;
SEARCH_SOURCE += [ FDirName $(HAIKU_TOP) src preferences network ] ;

# Settings itself is the window, Home, the list, search, the lock and the
# loader. Every page is an add-on of its own in add-ons/Settings, one page
# per add-on (ModuleAPI.md). Do not build a page into this program.
Application Settings :
	SettingsApp.cpp
	SettingsWindow.cpp
	SettingsManager.cpp
	SettingsStorage.cpp
	SettingsHost.cpp
	HomeView.cpp
	SettingsFont.cpp
	SettingsIcon.cpp
	: be tracker translation shared libr5icons.so libr5ui.so libr5admin.so
		[ TargetLibstdc++ ] localestub
	: Settings.rdef
	;

# The pages. Each add-on is installed in add-ons/Settings by
# build/jam/packages/Haiku (distro/desktop), in both images.
local r5SettingsLibs = be shared localestub libr5icons.so libr5ui.so
	[ TargetLibstdc++ ] ;

Addon settings_wallpaper :
	WallpaperModule.cpp
	SettingsFont.cpp
	: $(r5SettingsLibs) translation tracker
	;

Addon settings_deskbar :
	DeskbarModule.cpp
	SettingsFont.cpp
	: $(r5SettingsLibs)
	;

Addon settings_theme :
	ThemeModule.cpp
	ColorsView.cpp
	Colors.cpp
	SettingsFont.cpp
	: $(r5SettingsLibs)
	;

Addon settings_notifications :
	NotificationsModule.cpp
	SettingsFont.cpp
	: $(r5SettingsLibs) tracker
	;

Addon settings_virtualmemory :
	VirtualMemoryModule.cpp
	SettingsFont.cpp
	: $(r5SettingsLibs)
	;

Addon settings_power :
	PowerModule.cpp
	SettingsFont.cpp
	: $(r5SettingsLibs) libr5power.so
	;

Addon settings_information :
	InformationModule.cpp
	SettingsFont.cpp
	: $(r5SettingsLibs)
	;

Addon settings_display :
	DisplayModule.cpp
	DisplayScreens.cpp
	SettingsFont.cpp
	: $(r5SettingsLibs)
	;

Addon settings_wifi :
	WiFiModule.cpp
	: $(r5SettingsLibs) libr5wifi.so
	;

Addon settings_connections :
	ConnectionsModule.cpp
	NetworkPage.cpp
	IPAddressControl.cpp
	SettingsFont.cpp
	: <src!bin!network!ifconfig>MediaTypes.o
		$(r5SettingsLibs) bnetapi network
	;

Addon settings_discovery :
	DiscoveryModule.cpp
	NetworkPage.cpp
	NetworkSettingsAddOn.cpp
	ServiceListItem.cpp
	ServiceView.cpp
	SettingsFont.cpp
	: $(r5SettingsLibs) bnetapi network
	;

Addon settings_accounts :
	AccountsModule.cpp
	AccountDialogs.cpp
	SettingsFont.cpp
	: $(r5SettingsLibs) libr5admin.so translation tracker
	;

# The launchers of the preference programs that stay separate windows
# (LegacyPages.cpp), one add-on each.
Addon settings_sound :
	LegacySound.cpp
	LegacyPages.cpp
	: $(r5SettingsLibs)
	;

Addon settings_keyboard :
	LegacyKeyboard.cpp
	LegacyPages.cpp
	: $(r5SettingsLibs)
	;

Addon settings_mouse :
	LegacyMouse.cpp
	LegacyPages.cpp
	: $(r5SettingsLibs)
	;

Addon settings_printers :
	LegacyPrinters.cpp
	LegacyPages.cpp
	: $(r5SettingsLibs)
	;

# The Bluetooth page (docs/BLUETOOTH.md, step 3a). An add-on, so Settings
# itself does not need libr5bt.so and libbluetooth.so, which only the regular
# image ships.
Addon settings_bluetooth :
	BluetoothModule.cpp
	SettingsFont.cpp
	: be shared localestub libr5bt.so [ TargetLibstdc++ ]
	;

# The Game controllers page (docs/GAME-CONTROLLERS.md, option B). An add-on
# like the Bluetooth page, so Settings itself does not link libr5game.so.
# It shares the filled box, its title and the link with Connections.
Addon settings_gamecontrollers :
	GameControllersModule.cpp
	NetworkPage.cpp
	SettingsFont.cpp
	: be shared localestub libr5ui.so libr5icons.so libr5game.so
		[ TargetLibstdc++ ]
	;

Addon settings_fonts :
	FontsModule.cpp
	FontView.cpp
	FontSelectionView.cpp
	AntialiasingSettingsView.cpp
	SettingsFont.cpp
	: be shared localestub libr5ui.so [ TargetLibstdc++ ]
	;

# The catalogs. A page add-on carries its own signature
# (<target>.rdef), because the Locale Kit finds an image's catalog by the
# signature of that file. Settings uses application/x-vnd.R5OS-Settings.
DoCatalogs Settings :
	x-vnd.R5OS-Settings
	:
	SettingsApp.cpp
	SettingsWindow.cpp
	SettingsManager.cpp
	SettingsStorage.cpp
	SettingsHost.cpp
	HomeView.cpp
	SettingsFont.cpp
	SettingsIcon.cpp
	;

rule R5SettingsPageCatalog name : sources
{
	AddResources $(name) : $(name).rdef ;
	DoCatalogs $(name) : x-vnd.R5OS-$(name) : $(sources) ;
}

R5SettingsPageCatalog settings_wallpaper : WallpaperModule.cpp ;
R5SettingsPageCatalog settings_deskbar : DeskbarModule.cpp ;
R5SettingsPageCatalog settings_theme : ThemeModule.cpp ColorsView.cpp Colors.cpp ;
R5SettingsPageCatalog settings_notifications : NotificationsModule.cpp ;
R5SettingsPageCatalog settings_virtualmemory : VirtualMemoryModule.cpp ;
R5SettingsPageCatalog settings_power : PowerModule.cpp ;
R5SettingsPageCatalog settings_information : InformationModule.cpp ;
R5SettingsPageCatalog settings_display : DisplayModule.cpp DisplayScreens.cpp ;
R5SettingsPageCatalog settings_wifi : WiFiModule.cpp ;
R5SettingsPageCatalog settings_connections : ConnectionsModule.cpp NetworkPage.cpp ;
R5SettingsPageCatalog settings_discovery : DiscoveryModule.cpp NetworkPage.cpp
	ServiceListItem.cpp ServiceView.cpp ;
R5SettingsPageCatalog settings_accounts : AccountsModule.cpp AccountDialogs.cpp ;
R5SettingsPageCatalog settings_sound : LegacySound.cpp LegacyPages.cpp ;
R5SettingsPageCatalog settings_keyboard : LegacyKeyboard.cpp LegacyPages.cpp ;
R5SettingsPageCatalog settings_mouse : LegacyMouse.cpp LegacyPages.cpp ;
R5SettingsPageCatalog settings_printers : LegacyPrinters.cpp LegacyPages.cpp ;
R5SettingsPageCatalog settings_bluetooth : BluetoothModule.cpp ;
R5SettingsPageCatalog settings_gamecontrollers : GameControllersModule.cpp NetworkPage.cpp ;
R5SettingsPageCatalog settings_fonts : FontsModule.cpp FontView.cpp FontSelectionView.cpp AntialiasingSettingsView.cpp ;
