+#if defined(__HAIKU__) || defined(R5_HOST_TEST)
+#include <pthread.h>
+
+extern int r5_bo_cpu_map(int fd, unsigned int handle, void **cpu, int *area);
+extern int r5_bo_cpu_unmap(int fd, int area);
+
+struct r5_cpu_map {
+   uint32_t handle;
+   int area;
+   void *cpu;
+   uint32_t refs;
+};
+
+static struct r5_cpu_map r5_cpu_maps[32];
+static pthread_mutex_t r5_cpu_map_mu = PTHREAD_MUTEX_INITIALIZER;
+
+static int
+r5_cpu_map_get(uint32_t handle, void **cpu_out)
+{
+   unsigned i;
+   pthread_mutex_lock(&r5_cpu_map_mu);
+   for (i = 0; i < 32; i++) {
+      if (r5_cpu_maps[i].handle == handle) {
+         r5_cpu_maps[i].refs++;
+         *cpu_out = r5_cpu_maps[i].cpu;
+         pthread_mutex_unlock(&r5_cpu_map_mu);
+         return 1;
+      }
+   }
+   pthread_mutex_unlock(&r5_cpu_map_mu);
+   return 0;
+}
+
+/* One slot per handle. Returns 0 when saved in a new slot, 1 when another
+ * thread already saved this handle (sets *cpu_out and *existing_area_out
+ * with refs++), or -1 when all 32 slots are occupied by other handles. */
+static int
+r5_cpu_map_save(uint32_t handle, int area, void *mapped_cpu, void **cpu_out,
+                int *existing_area_out)
+{
+   unsigned i;
+   pthread_mutex_lock(&r5_cpu_map_mu);
+   for (i = 0; i < 32; i++) {
+      if (r5_cpu_maps[i].handle == handle) {
+         r5_cpu_maps[i].refs++;
+         *cpu_out = r5_cpu_maps[i].cpu;
+         *existing_area_out = r5_cpu_maps[i].area;
+         pthread_mutex_unlock(&r5_cpu_map_mu);
+         return 1;
+      }
+   }
+   for (i = 0; i < 32; i++) {
+      if (r5_cpu_maps[i].handle == 0) {
+         r5_cpu_maps[i].handle = handle;
+         r5_cpu_maps[i].area = area;
+         r5_cpu_maps[i].cpu = mapped_cpu;
+         r5_cpu_maps[i].refs = 1;
+         *cpu_out = mapped_cpu;
+         pthread_mutex_unlock(&r5_cpu_map_mu);
+         return 0;
+      }
+   }
+   pthread_mutex_unlock(&r5_cpu_map_mu);
+   return -1;
+}
+
+/* Returns 1 and sets *area_out when the last reference is dropped; 0 when
+ * references remain; -1 when the handle was not found. */
+static int
+r5_cpu_map_take(uint32_t handle, int *area_out)
+{
+   unsigned i;
+   pthread_mutex_lock(&r5_cpu_map_mu);
+   for (i = 0; i < 32; i++) {
+      if (r5_cpu_maps[i].handle == handle) {
+         if (r5_cpu_maps[i].refs > 1) {
+            r5_cpu_maps[i].refs--;
+            pthread_mutex_unlock(&r5_cpu_map_mu);
+            return 0;
+         }
+         *area_out = r5_cpu_maps[i].area;
+         r5_cpu_maps[i].handle = 0;
+         r5_cpu_maps[i].area = 0;
+         r5_cpu_maps[i].cpu = NULL;
+         r5_cpu_maps[i].refs = 0;
+         pthread_mutex_unlock(&r5_cpu_map_mu);
+         return 1;
+      }
+   }
+   pthread_mutex_unlock(&r5_cpu_map_mu);
+   return -1;
+}
