//
// M11 step 4 (decision 16): the effects pipeline. The copy shader
// (compose.comp) stays as it is for everything without an effect. This one
// unpacks the 32-bit words to vec4, blends, and filters bilinearly itself
// (the buffers are VkBuffers, not images). One mode per dispatch:
//
//   0 shadow: darkens the frame by a window's blurred alpha mask
//   1 down:   one Dual Kawase level down (5 taps, half the size)
//   2 up:     one Dual Kawase level up (8 taps, twice the size)
//   3 glass:  a window's pixels over the kept blur of what lies behind
//   4 window: a window scaled about its centre and faded, for the open and
//             close animations (step 4b)
//   5 slide:  the workspace switch, the old picture and the new side by side
//   6 corner: a round window's corner: the window's pixel with the
//             decorator's edge line round the arc, blended by coverage
//             (shape[0]: the circle's centre x, y and radius; shape[1]:
//             the line's colour as a frame word and its width); mode 3
//             does the same for glass when shape[0].w is 1, and mode 4
//             rounds a window's corners when auxStride is 1 (shape[1]:
//             the four radii)
//
// M13 step 2: with 0x10 in the mode, modes 3 and 4 read the window from its
// image (binding 3) instead of the source buffer: a window that Skia draws.
// Mode 3 reads texel by texel; mode 4 filters through the sampler
// (VK_FILTER_LINEAR).
//
// Compiled by scripts/gen-compositor-shaders.sh.

#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer Source {
	uint pixels[];
} source;

layout(std430, set = 0, binding = 1) buffer Target {
	uint pixels[];
} target;

layout(std430, set = 0, binding = 2) readonly buffer Aux {
	uint pixels[];
} aux;

layout(set = 0, binding = 3) uniform sampler2D image;

layout(push_constant) uniform Effect {
	uint mode;
	uint width;			// the rectangle written
	uint height;
	uint targetX;		// its place in the target buffer
	uint targetY;
	uint targetStride;
	uint sourceX;		// shadow: in the mask, glass: in the window buffer,
	uint sourceY;		// down/up: the source level's place in its buffer
	uint sourceStride;	// (shadow: in bytes)
	uint sourceWidth;	// down/up: the source level, for clamping
	uint sourceHeight;
	uint auxX;			// glass: the rectangle in the blur cache;
	uint auxY;			// down/up: the rectangle's place in its level
	uint auxStride;
	uint amount;		// shadow: strength, glass: see-through (0..255),
						// bit 8 for glass: fixed (tab and frame line)
	float offset;		// down/up: the Kawase offset in source pixels;
						// window: the scale; slide: the direction (+1, -1)
	ivec4 shape[4];		// window: its footprint, up to four rectangles in
						// buffer coordinates (left, top, right, bottom)
} effect;


vec4
unpack(uint word)
{
	return vec4(float(word & 0xffu), float((word >> 8) & 0xffu),
		float((word >> 16) & 0xffu), float(word >> 24)) / 255.0;
}


uint
pack(vec4 color)
{
	uvec4 c = uvec4(clamp(color, 0.0, 1.0) * 255.0 + 0.5);
	return c.x | (c.y << 8) | (c.z << 16) | (c.w << 24);
}


bool
fromImage()
{
	return (effect.mode & 0x10u) != 0u;
}


// the image's texel in the order of a buffer word (B, G, R, A)
vec4
imageTexel(ivec2 at)
{
	return texelFetch(image, at, 0).bgra;
}


vec4
texel(int x, int y)
{
	x = clamp(x, 0, int(effect.sourceWidth) - 1);
	y = clamp(y, 0, int(effect.sourceHeight) - 1);
	if (fromImage()) {
		return imageTexel(ivec2(int(effect.sourceX) + x,
			int(effect.sourceY) + y));
	}
	return unpack(source.pixels[(effect.sourceY + uint(y))
		* effect.sourceStride + effect.sourceX + uint(x)]);
}


// The share of pixel `at` inside the circle of radius r around the point c
// (between pixels): the formula of WindowOutline.h in app_server.
float
cornerCoverage(ivec2 at, ivec2 c, int r)
{
	vec2 d = vec2(at) + 0.5 - vec2(c);
	return clamp(float(r) + 0.5 - length(d), 0.0, 1.0);
}


// The window's pixel at `at` in its buffer (or image).
vec4
windowPixel(ivec2 at)
{
	if (fromImage())
		return imageTexel(at);
	return unpack(source.pixels[uint(at.y) * effect.sourceStride
		+ uint(at.x)]);
}


// Blending at the arc in linear light (review, 22 Nov 2026: in sRGB a
// high-contrast edge came out darker and harsher). An approximation with
// the 2.2 power, enough for one pixel of edge.
vec3
blendLinear(vec3 a, vec3 b, float t)
{
	vec3 mixed = mix(pow(a, vec3(2.2)), pow(b, vec3(2.2)), t);
	return pow(max(mixed, vec3(0.0)), vec3(1.0 / 2.2));
}


// The signed distance of pixel `at` from a corner's arc (shape[0]: the
// circle): negative inside. Inside the corner's square this is the
// distance of the rounded rectangle.
float
cornerDistance(ivec2 at)
{
	vec2 d = vec2(at) + 0.5 - vec2(effect.shape[0].xy);
	return length(d) - float(effect.shape[0].z);
}


// How much of the pixel the decorator's edge line covers (shape[1].y: its
// width, 0: none): all of it up to the outer edge, fading only inwards, so
// the content never shows through the line (review: a symmetric ring let
// half of the content through at the outermost pixel).
float
edgeLineMix(float distance)
{
	float width = float(effect.shape[1].y);
	if (width <= 0.0)
		return 0.0;
	float alpha = unpack(uint(effect.shape[1].x)).a;
	return clamp(distance + width + 0.5, 0.0, 1.0) * alpha;
}


// The decorator's edge line colour (shape[1].x, a frame word).
vec3
edgeLineColor()
{
	return unpack(uint(effect.shape[1].x)).rgb;
}


// Bilinear filtering of the source level at a position in texel-centre
// coordinates (texel i is at i), clamped to the level's edge.
vec4
sampleBilinear(vec2 at)
{
	vec2 base = floor(at);
	vec2 f = at - base;
	int x = int(base.x);
	int y = int(base.y);
	vec4 top = mix(texel(x, y), texel(x + 1, y), f.x);
	vec4 bottom = mix(texel(x, y + 1), texel(x + 1, y + 1), f.x);
	return mix(top, bottom, f.y);
}


void
main()
{
	uvec2 at = gl_GlobalInvocationID.xy;
	if (at.x >= effect.width || at.y >= effect.height)
		return;
	uint index = (effect.targetY + at.y) * effect.targetStride
		+ effect.targetX + at.x;
	uint mode = effect.mode & 0xfu;

	if (mode == 0u) {
		uint byteIndex = (effect.sourceY + at.y) * effect.sourceStride
			+ effect.sourceX + at.x;
		uint mask = (source.pixels[byteIndex >> 2] >> ((byteIndex & 3u) * 8u))
			& 0xffu;
		uint dim = mask * effect.amount;
		if (dim == 0u)
			return;
		vec4 color = unpack(target.pixels[index]);
		color.rgb *= 1.0 - float(dim) / 65025.0;
		color.a = 1.0;
		target.pixels[index] = pack(color);
		return;
	}

	if (mode == 1u) {
		// The centre of this pixel lies between four source texels.
		vec2 centre = vec2(at + uvec2(effect.auxX, effect.auxY)) * 2.0 + 0.5;
		float o = effect.offset;
		vec4 sum = sampleBilinear(centre) * 4.0;
		sum += sampleBilinear(centre + vec2(-o, -o));
		sum += sampleBilinear(centre + vec2(o, o));
		sum += sampleBilinear(centre + vec2(o, -o));
		sum += sampleBilinear(centre + vec2(-o, o));
		target.pixels[index] = pack(sum / 8.0);
		return;
	}

	if (mode == 2u) {
		vec2 centre = (vec2(at + uvec2(effect.auxX, effect.auxY)) + 0.5)
			* 0.5 - 0.5;
		float o = effect.offset;
		vec4 sum = sampleBilinear(centre + vec2(-2.0 * o, 0.0));
		sum += sampleBilinear(centre + vec2(2.0 * o, 0.0));
		sum += sampleBilinear(centre + vec2(0.0, -2.0 * o));
		sum += sampleBilinear(centre + vec2(0.0, 2.0 * o));
		sum += sampleBilinear(centre + vec2(-o, o)) * 2.0;
		sum += sampleBilinear(centre + vec2(o, o)) * 2.0;
		sum += sampleBilinear(centre + vec2(o, -o)) * 2.0;
		sum += sampleBilinear(centre + vec2(-o, -o)) * 2.0;
		target.pixels[index] = pack(sum / 12.0);
		return;
	}

	if (mode == 4u) {
		// The output pixel, in the window buffer's coordinates, back to
		// where it lies in the window before the scale.
		vec2 size = vec2(float(effect.sourceWidth), float(effect.sourceHeight));
		vec2 centre = size * 0.5;
		vec2 here = vec2(at + uvec2(effect.auxX, effect.auxY)) + 0.5;
		vec2 from = centre + (here - centre) / effect.offset - 0.5;
		ivec2 nearest = ivec2(floor(from + 0.5));
		bool inside = false;
		// a round window has its bounding box in shape[0], its radii in
		// shape[1]
		int rects = effect.auxStride != 0u ? 1 : 4;
		for (int i = 0; i < rects; i++) {
			ivec4 r = effect.shape[i];
			if (r.x <= r.z && nearest.x >= r.x && nearest.x <= r.z
				&& nearest.y >= r.y && nearest.y <= r.w)
				inside = true;
		}
		if (!inside)
			return;
		// A round window (auxStride 1): the corners of its bounding box,
		// each with its own radius (shape[1]: left top, right top, left
		// bottom, right bottom), anti-aliased.
		float cover = 1.0;
		if (effect.auxStride != 0u) {
			ivec4 box = effect.shape[0];
			bool right = nearest.x * 2 > box.x + box.z;
			bool bottom = nearest.y * 2 > box.y + box.w;
			ivec4 radii = effect.shape[1];
			int r = bottom ? (right ? radii.w : radii.z)
				: (right ? radii.y : radii.x);
			if (r > 0) {
				ivec2 c = ivec2(clamp(nearest.x, box.x + r, box.z + 1 - r),
					clamp(nearest.y, box.y + r, box.w + 1 - r));
				cover = cornerCoverage(nearest, c, r);
				if (cover <= 0.0)
					return;
			}
		}
		vec4 window;
		if (fromImage()) {
			// the sampler filters; texel centres are at i + 0.5
			window = textureLod(image, (from + 0.5) / size, 0.0).bgra;
		} else
			window = sampleBilinear(from);
		vec4 below = unpack(target.pixels[index]);
		float alpha = float(effect.amount) / 255.0 * cover;
		target.pixels[index] = pack(vec4(mix(below.rgb, window.rgb, alpha),
			1.0));
		return;
	}

	if (mode == 5u) {
		// source: the old picture, aux: the new one, both with the
		// target's stride; amount: how far the new one has come in.
		int width = int(effect.width);
		int x = int(at.x + effect.targetX);
		int shift = int(effect.amount);
		uint row = (effect.targetY + at.y) * effect.targetStride;
		int moved = effect.offset > 0.0 ? x + shift : x - shift;
		if (moved >= 0 && moved < width)
			target.pixels[index] = source.pixels[row + uint(moved)];
		else {
			int other = effect.offset > 0.0 ? moved - width : moved + width;
			target.pixels[index] = aux.pixels[row + uint(other)];
		}
		return;
	}

	if (mode == 6u) {
		// A round corner (shape[0]: the circle, shape[1]: the decorator's
		// edge line): the window's pixel with the edge line carried round
		// the arc, over what lies below by the pixel's coverage.
		ivec2 here = ivec2(effect.targetX + at.x, effect.targetY + at.y);
		float distance = cornerDistance(here);
		vec4 pixel = windowPixel(ivec2(effect.sourceX + at.x,
			effect.sourceY + at.y));
		vec3 color = blendLinear(pixel.rgb, edgeLineColor(),
			edgeLineMix(distance));
		float coverage = clamp(0.5 - distance, 0.0, 1.0);
		vec4 below = unpack(target.pixels[index]);
		target.pixels[index] = pack(vec4(blendLinear(below.rgb, color,
			coverage), 1.0));
		return;
	}

	// mode 3: glass. Outside the glass region every pixel is opaque, so
	// this mode only runs inside it (decision 16).
	vec4 pixel = fromImage()
		? imageTexel(ivec2(effect.sourceX + at.x, effect.sourceY + at.y))
		: unpack(source.pixels[(effect.sourceY + at.y)
			* effect.sourceStride + effect.sourceX + at.x]);
	vec4 blur = unpack(aux.pixels[(effect.auxY + at.y) * effect.auxStride
		+ effect.auxX + at.x]);
	float seeThrough = float(effect.amount & 0xffu) / 255.0;
	bool fixedGlass = (effect.amount & 0x100u) != 0u;
	bool darkGlass = (effect.amount & 0x200u) != 0u;
	vec3 color;
	if (fixedGlass || pixel.a == 0.0) {
		// The tab and the frame line, and a glass view's own background:
		// its colour, with this much of the blur showing through.
		color = mix(pixel.rgb, blur.rgb, seeThrough);
	} else if (pixel.a == 1.0) {
		color = pixel.rgb;
	} else {
		// what a program drew with B_ALPHA_COMPOSITE on a glass view: blend
		// over the tinted glass surface (not raw blur.rgb, which leaked
		// bright light-blue wallpaper halos round text and icons on dark glass)
		vec3 surface = darkGlass
			? vec3(22.0 / 255.0, 26.0 / 255.0, 34.0 / 255.0)
			: vec3(240.0 / 255.0, 245.0 / 255.0, 252.0 / 255.0);
		vec3 glassBase = mix(surface, blur.rgb, seeThrough);
		color = mix(glassBase, pixel.rgb, pixel.a);
	}
	if (effect.shape[0].w == 1) {
		// glass in a round corner: the decorator's edge line round the
		// arc, then blended by the pixel's coverage
		ivec2 here = ivec2(effect.targetX + at.x, effect.targetY + at.y);
		float distance = cornerDistance(here);
		color = blendLinear(color, edgeLineColor(), edgeLineMix(distance));
		float coverage = clamp(0.5 - distance, 0.0, 1.0);
		vec4 below = unpack(target.pixels[index]);
		color = blendLinear(below.rgb, color, coverage);
	}
	target.pixels[index] = pack(vec4(color, 1.0));
}
