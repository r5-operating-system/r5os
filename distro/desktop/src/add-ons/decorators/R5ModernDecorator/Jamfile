SubDir HAIKU_TOP src add-ons decorators R5ModernDecorator ;

# Default (R5 Modern) builds the R5 frame class of Default (R5) as well, from
# that directory, under its own grist (docs/design/R5-MODERN-DECORATOR.md).
SEARCH_SOURCE += [ FDirName $(HAIKU_TOP) src add-ons decorators R5Decorator ] ;

UseBuildFeatureHeaders freetype ;
UseHeaders [ FDirName $(HAIKU_TOP) src add-ons decorators R5Decorator ] ;
UseHeaders [ FDirName $(HAIKU_TOP) src servers app ] ;
UseHeaders [ FDirName $(HAIKU_TOP) src servers app stackandtile ] ;
UseHeaders [ FDirName $(HAIKU_TOP) src servers app decorator ] ;
UseHeaders [ FDirName $(HAIKU_TOP) src servers app drawing ] ;
UseHeaders [ FDirName $(HAIKU_TOP) src servers app drawing Painter ] ;
UseHeaders [ FDirName $(HAIKU_TOP) src servers app drawing interface local ] ;
UseHeaders [ FDirName $(HAIKU_TOP) src servers app font ] ;
UsePrivateHeaders app shared interface graphics ;
UseLibraryHeaders agg ;

AddResources R5ModernDecorator : resources.rdef ;

Includes [ FGristFiles R5Decorator.cpp R5ModernDecorator.cpp ]
	: [ BuildFeatureAttribute freetype : headers ] ;

Addon R5ModernDecorator :
	R5Decorator.cpp
	R5ModernDecorator.cpp
	: be <nogrist>app_server [ TargetLibstdc++ ] [ TargetLibsupc++ ]
;
