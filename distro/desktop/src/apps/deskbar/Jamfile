	# Deskbar styles (docs/design/DESKBAR-STYLES.md)
	DeskbarStyle.cpp
	DeskbarStyleViews.cpp
# SPDX-SnippetEnd
	: be translation localestub tracker $(targetLib) [ TargetLibstdc++ ] [ TargetLibsupc++ ]
# SPDX-SnippetBegin
