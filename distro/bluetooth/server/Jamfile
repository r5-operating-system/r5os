SubDir HAIKU_TOP src servers bluetooth ;

UsePrivateHeaders shared bluetooth net ;

# SPDX-SnippetBegin
# SPDX-SnippetCopyrightText: 2026 R5OS Contributors
# SPDX-License-Identifier: MIT
# LE Secure Connections: ECDH P-256 and AES-CMAC from OpenSSL libcrypto
# (docs/BLUETOOTH.md, section 4, choice 3), as airplay_server uses it.
local opensslRoot = [ FDirName $(HAIKU_TOP) generated.$(TARGET_PACKAGING_ARCH)
	r5-openssl ] ;
UseHeaders [ FDirName $(opensslRoot) include ] : true ;
local opensslLib = [ FDirName $(opensslRoot) lib libcrypto.so.3 ] ;
# SPDX-SnippetEnd

AddResources bluetooth_server : bluetooth_server.rdef ;

Application bluetooth_server
 	:
	BluetoothServer.cpp
	DeskbarReplicant.cpp
	DeviceManager.cpp
	HCIControllerAccessor.cpp
	HIDHost.cpp
	HCITransportAccessor.cpp
	LEManager.cpp
	LEManagerGATT.cpp
	LEManagerSMP.cpp
	LocalDeviceHandler.cpp
	LocalDeviceImpl.cpp
	LocalDeviceVoice.cpp
	PairingNotice.cpp
	PasskeyWindow.cpp
	HFPAgent.cpp
	HFPGateway.cpp
	RFCOMMLink.cpp
	RFCOMMMux.cpp
	SDPServer.cpp
	SDPClient.cpp
	SMPCrypto.cpp
	: be network libbluetooth.so libr5admin.so localestub $(opensslLib)
	[ TargetLibstdc++ ]
;

DoCatalogs bluetooth_server :
	x-vnd.Haiku-bluetooth_server
	:
	DeskbarReplicant.cpp
	PairingNotice.cpp
	PasskeyWindow.cpp
;
