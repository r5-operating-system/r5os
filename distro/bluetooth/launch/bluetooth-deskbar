# The Bluetooth item in Deskbar, for every person who signs in (regular image
# only, docs/BLUETOOTH.md step 3b). The job adds the item and exits.

target desktop {
	job x-vnd.R5OS-bluetooth-deskbar {
		launch /system/servers/bluetooth_deskbar
		requires x-vnd.Be-TSKB
		on initial_volumes_mounted
		legacy
		no_safemode
	}
}
