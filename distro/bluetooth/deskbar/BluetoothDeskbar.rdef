resource app_signature "application/x-vnd.R5OS-bluetooth-deskbar";

resource app_flags B_SINGLE_LAUNCH | B_BACKGROUND_APP;

resource app_name_catalog_entry "BluetoothDeskbar:application name" "Bluetooth";

resource app_version {
	major  = 1,
	middle = 0,
	minor  = 0,

	variety = B_APPV_DEVELOPMENT,
	internal = 0,

	short_info = "Bluetooth in Deskbar",
	long_info = "Adds the Bluetooth item to Deskbar, then exits."
};
