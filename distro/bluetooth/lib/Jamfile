# libr5bt.so: the R5 Bluetooth Kit (<R5Bluetooth.h>), shared by the
# Bluetooth page of Settings and, later, the Bluetooth program. It talks to
# bluetooth_server through libbluetooth. docs/LIBR5.md, "Bluetooth".

SubDir HAIKU_TOP src preferences r5bt ;

UsePrivateHeaders app bluetooth ;

# bluetooth_audio's choice file ("Use for sound"), shared with bt_audio.
SEARCH_SOURCE += [ FDirName $(HAIKU_TOP) src add-ons media media-add-ons
	bluetooth_audio ] ;
SubDirHdrs [ FDirName $(HAIKU_TOP) src add-ons media media-add-ons
	bluetooth_audio ] ;

# The signature by which the Locale Kit finds this library's catalog.
AddResources [ MultiArchDefaultGristFiles libr5bt.so ] : libr5bt.rdef ;

SharedLibrary [ MultiArchDefaultGristFiles libr5bt.so ] :
	BluetoothController.cpp
	BluetoothView.cpp
	AudioSettings.cpp
	: be media device libbluetooth.so localestub libr5icons.so libr5ui.so
		libr5admin.so [ TargetLibstdc++ ]
	;

DoCatalogs libr5bt.so :
	x-vnd.R5OS-libr5bt
	:
	BluetoothController.cpp
	BluetoothView.cpp
	;
