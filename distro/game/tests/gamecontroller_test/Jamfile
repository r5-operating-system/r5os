# gamecontroller_test: libr5game.so without a real controller
# (docs/GAME-CONTROLLERS.md). Regular image only.
SubDir HAIKU_TOP src bin gamecontroller_test ;

UsePrivateHeaders bluetooth device ;
SubDirHdrs $(HAIKU_TOP) src preferences r5game ;
SEARCH_SOURCE += [ FDirName $(HAIKU_TOP) src preferences r5game ] ;

Application gamecontroller_test :
	gamecontroller_test.cpp
	GameControllerMapping.cpp
	: be libr5game.so libr5icons.so [ TargetLibstdc++ ]
	;
